//@version=6
// =============================================================================
//  PM15 BRAIN  v1.1 — Polymarket US 15-minute BTC Up/Down, one script
//  ---------------------------------------------------------------------------
//  Replaces "Velocity Reach vs Target" + "Alpha Engine v6.x" on the chart.
//  Built on what the Oct 27 screen recordings showed:
//    • Polymarket's displayed price = the 60-second trailing AVERAGE of spot,
//      ~2 s delayed, plus a basis offset (fit error $0.34 vs Coinbase).
//    • The final price is that average at the bell. The price-to-beat is that
//      average at the open, i.e. the previous round's settlement.
//    • So in the last minute part of the result is already in the books, and
//      "locked" can be computed instead of guessed.
//  What it does, in priority order (top line of the HUD):
//    1. In a position  → HOLD / SELL HALF / SELL NOW, with the flip ETA.
//    2. Locked favorite for sale under your max → FREE MONEY: BUY, cents on
//       the table after fee, time to get filled.
//    3. Early Favorite check (13:00 / 12:00 left, favorite at 80–94¢) — your
//       tested rule from Oct 6–22.
//    4. Alpha conviction gate (6 lights) inside the 3:00–13:45 window.
//    5. Otherwise WAIT, with the reason and the time to the next event.
//  Odds come from the settlement-average model (vol-based, momentum credited
//  for 45 s at most). The momentum post is kept as a VIEW, never as odds.
//  The label on the post (between the spot and the target) says how many
//  minutes BTC would need to reach the target at the FASTEST it has ever moved
//  (record up / down moves over 1–15 min from the chart's history plus 5-min
//  and 15-min bars), and compares that with the time left:
//    red = NOT POSSIBLE (needs more than the time left even at record pace)
//    orange = UNLIKELY · yellow = EASILY · green = MOST LIKELY (touch odds).
//  Live ticks: on the realtime bar the script records every tick (varip) so the
//  60-s average and the known part of the settlement window are exact; on
//  history it uses the bar's OHLC blend.
//  Built for a 1-min chart on Coinbase BTC-USD.
// =============================================================================
indicator("PM15 Brain", shorttitle = "PM15 Brain", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_polylines_count = 5)

// ─────────────────────────────── Inputs ───────────────────────────────
gT = "Target (price to beat)"
tgtTyped = input.float(0.0, "Target from your PM screen ($, 0 = estimate it)", step = 0.01, group = gT)
tgtAdj   = input.float(0.0, "Basis offset ($) = PM target − chart estimate (learned automatically once you type a target)", step = 0.5, group = gT, display = display.none)

gM = "Market (type what Polymarket shows, optional)"
mktUp   = input.float(0.0, "UP ask (¢, 0 = off)", minval = 0, maxval = 100, step = 1, group = gM, display = display.none)
mktDn   = input.float(0.0, "DOWN ask (¢, 0 = off)", minval = 0, maxval = 100, step = 1, group = gM, display = display.none)
maxLock = input.int(97, "Max to pay for a LOCKED play (¢)", minval = 50, maxval = 99, group = gM, display = display.none)
lockPct = input.float(99.5, "Locked = win probability ≥ (%)", minval = 90, maxval = 99.99, step = 0.1, group = gM, display = display.none)
feeCoef = input.float(0.0695, "Taker fee coefficient", minval = 0, maxval = 0.2, step = 0.0005, group = gM, display = display.none)

gE = "Entry rules"
useEF    = input.bool(true, "Early Favorite rule: at 13:00 / 12:00 left buy the favorite if it shows 80–94¢", group = gE, display = display.none)
efLo     = input.int(80, "EF: favorite ask at least (¢)", minval = 50, maxval = 98, group = gE, display = display.none)
efHi     = input.int(94, "EF: and at most (¢)", minval = 51, maxval = 99, group = gE, display = display.none)
useAlpha = input.bool(true, "Alpha conviction gate (lights below)", group = gE, display = display.none)
minConv  = input.int(5, "Alpha: lights needed (of 6)", minval = 1, maxval = 6, group = gE, display = display.none)
buffer   = input.float(20.0, "Alpha: lead / TWAP buffer vs target ($)", step = 1, group = gE, display = display.none)
chopBand = input.float(10.0, "Alpha: chop band ($)", step = 1, group = gE, display = display.none)
entryFrom = input.float(3.0, "Alpha: window opens (min elapsed)", step = 0.25, group = gE, display = display.none)
entryTo   = input.float(13.75, "Alpha: window closes (min elapsed)", step = 0.25, group = gE, display = display.none)
killSecs  = input.int(45, "No new buys in the last (sec)", minval = 0, maxval = 300, group = gE, display = display.none)
safeP     = input.float(0.80, "Alpha light 5: adverse-vol P(win) at least", step = 0.05, minval = 0.5, maxval = 0.99, group = gE, display = display.none)
maxAskA   = input.float(0.85, "Alpha light 6: max price you will pay", step = 0.01, minval = 0.05, maxval = 0.99, group = gE, display = display.none)
twapLen   = input.int(15, "TWAP window (bars)", minval = 3, group = gE, display = display.none)
atrLen    = input.int(14, "ATR length", group = gE, display = display.none)
atrMult   = input.float(2.5, "Stand down if ATR > x · ATR avg(100)", step = 0.1, group = gE, display = display.none)
volLen    = input.int(60, "Realised-vol window (bars)", minval = 10, group = gE, display = display.none)

gP = "In position (set after you buy)"
posSide  = input.string("None", "Side", options = ["None", "Up", "Down"], group = gP, display = display.none)
posEntry = input.float(78.0, "Entry price (¢)", step = 1, minval = 1, maxval = 99, group = gP, display = display.none)
posUsd   = input.float(20.0, "Dollars in", step = 10, group = gP, display = display.none)

gV = "Physics"
velLen    = input.int(14, "Velocity lookback (bars)", minval = 1, group = gV, display = display.none)
smoothLen = input.int(5, "Smoothing (EMA)", minval = 1, group = gV, display = display.none)
driftW    = input.float(0.3, "Momentum credited in the odds (0–1, 45 s at most)", minval = 0, maxval = 1, step = 0.1, group = gV, display = display.none)

gR = "Reach: minutes to the target at BTC's record pace"
recScale    = input.float(1.0, "Record margin (× the fastest move seen; 1 = as seen)", minval = 0.5, maxval = 3.0, step = 0.1, group = gR, display = display.none)
reachGreen  = input.int(50, "MOST LIKELY when the touch odds are at least (%)", minval = 1, maxval = 99, group = gR, display = display.none)
reachYellow = input.int(10, "EASILY when the touch odds are at least (%) — below that UNLIKELY; beyond the record NOT POSSIBLE", minval = 1, maxval = 99, group = gR, display = display.none)

gH = "HUD / chart"
hudPos   = input.string("Middle right", "HUD position", options = ["Middle right", "Middle left", "Top right", "Top left", "Bottom right", "Bottom left"], group = gH, display = display.none)
hudSize  = input.string("normal", "HUD text size", options = ["small", "normal", "large"], group = gH, display = display.none)
showPost = input.bool(true, "Momentum post with minute ticks", group = gH, display = display.none)
showTwap = input.bool(true, "TWAP line", group = gH, display = display.none)
showPM   = input.bool(true, "Line: what Polymarket shows (60-s average)", group = gH, display = display.none)
shadeRounds = input.bool(true, "Shade rounds and mark each 15-min boundary", group = gH, display = display.none)

gC = "Colors"
colTgt  = input.color(#ffb020, "Target line (brightest)", group = gC)
colPM   = input.color(#62ccff, "Polymarket shows", group = gC)
colPost = input.color(#b57cff, "Momentum post", group = gC)
colOk   = input.color(#28d978, "Good", group = gC)
colEasy = input.color(#ffe14d, "Easily (reach label, yellow)", group = gC)
colWarn = input.color(#ff8a1f, "Caution", group = gC)
colBad  = input.color(#ff4b5c, "Bad", group = gC)

// ─────────────────────────────── Helpers ───────────────────────────────
WIN = 60
DELAY = 2
fmtP(x) => str.tostring(x, "#,###.00")
fmt0(x) => str.tostring(x, "#")
fmt1(x) => str.tostring(x, "#.#")
fmtClock(s) =>
    int tot = int(math.max(0.0, s))
    int m   = int(tot / 60)
    int sec = tot - m * 60
    str.tostring(m) + ":" + (sec < 10 ? "0" : "") + str.tostring(sec)
secsTxt(s) => s < 60 ? fmt0(math.ceil(s)) + "s" : fmtClock(s)
pctTxt(p) => na(p) ? "—" : (p > 0.99 or p < 0.01 ? str.tostring(p * 100, "#.00") : str.tostring(p * 100, "#.#")) + "%"
fPhi(x) =>
    t = 1.0 / (1.0 + 0.2316419 * math.abs(x))
    d = 0.3989422804014327 * math.exp(-x * x / 2.0)
    p = d * t * (0.319381530 + t * (-0.356563782 + t * (1.781477937 + t * (-1.821255978 + t * 1.330274429))))
    x >= 0 ? 1.0 - p : p
fee(px) => feeCoef * px * (1.0 - px)
tblPos(s) =>
    s == "Top right" ? position.top_right : s == "Top left" ? position.top_left :
         s == "Middle right" ? position.middle_right : s == "Middle left" ? position.middle_left :
         s == "Bottom right" ? position.bottom_right : position.bottom_left
hudTxt = hudSize == "small" ? size.small : hudSize == "large" ? size.large : size.normal

// ─────────────────────── Round clock (quarter hours, UTC) ───────────────────────
roundMs    = 900000
roundStart = math.floor(time / 900000.0) * roundMs
roundEnd   = roundStart + roundMs
isNewRound = ta.change(roundStart) != 0
nowMs      = barstate.isrealtime ? timenow : time + 60000
secsLeft   = math.max(0.0, (roundEnd - nowMs) / 1000.0)
secsElapsed = 900.0 - secsLeft
minsElapsed = secsElapsed / 60.0
secIntoBar  = barstate.isrealtime ? math.max(0.0, math.min(60.0, (timenow - time) / 1000.0)) : 60.0

// ─────────────────────── Live tick buffer (realtime only) ───────────────────────
varip array<int>   tkT = array.new<int>()
varip array<float> tkP = array.new<float>()
if barstate.isrealtime
    array.push(tkT, timenow)
    array.push(tkP, close)
    while array.size(tkT) > 0 and timenow - array.get(tkT, 0) > 140000
        array.shift(tkT)
        array.shift(tkP)
// time-weighted average of the ticks inside [fromMs, toMs]; returns [avg, coverage 0..1]
tickAvg(fromMs, toMs) =>
    n = array.size(tkT)
    float acc = 0.0
    float dur = 0.0
    if n > 0 and toMs > fromMs
        for i = 0 to n - 1
            t1 = array.get(tkT, i)
            t2 = i < n - 1 ? array.get(tkT, i + 1) : timenow
            a = math.max(t1, fromMs)
            b = math.min(t2, toMs)
            if b > a
                acc += array.get(tkP, i) * (b - a)
                dur += (b - a)
    [dur > 0 ? acc / dur : float(na), toMs > fromMs ? dur / (toMs - fromMs) : 0.0]

// bar-based stand-in for a minute's time-average (history, and before the tick buffer fills)
barAvg = 0.5 * ohlc4 + 0.5 * hl2
// what Polymarket shows now: ticks when they cover the window, else the two-bar blend
[tkAvgNow, tkCovNow] = tickAvg(nowMs - (WIN + DELAY) * 1000, nowMs - DELAY * 1000)
pmBars  = ((60.0 - secIntoBar) * barAvg[1] + secIntoBar * barAvg) / 60.0
pmRaw   = tkCovNow >= 0.9 ? tkAvgNow : pmBars

// ─────────────────────────────── Target ───────────────────────────────
var float tgtEst = na          // chart estimate of the price-to-beat (the minute before the open)
var int   typedRound = na      // the round that was live when you last changed settings: the typed target belongs to it
var float offLearn = na        // basis offset learned from a typed target
if isNewRound
    [a, c] = tickAvg(roundStart - (WIN + DELAY) * 1000, roundStart - DELAY * 1000)
    tgtEst := c >= 0.9 ? a : barAvg[1]
if barstate.isrealtime and na(typedRound)
    typedRound := roundStart
if tgtTyped > 0 and roundStart == typedRound and not na(tgtEst)
    offLearn := tgtTyped - tgtEst
offset   = not na(offLearn) ? offLearn : tgtAdj
typedNow = tgtTyped > 0 and roundStart == typedRound
target   = typedNow ? tgtTyped : tgtEst + offset
tgtSrc   = typedNow ? "typed" : not na(offLearn) ? "estimate + learned offset" : tgtAdj != 0 ? "estimate + offset" : "estimate (no offset yet)"
pmShown  = pmRaw + offset

// ─────────────────── Volatility (per √second), symmetric and adverse ───────────────────
r1     = math.log(close / close[1])
up1    = r1 > 0 ? r1 : 0.0
dn1    = r1 < 0 ? r1 : 0.0
sigBar = ta.stdev(r1, volLen) * close                                   // $ per √bar
sigUpB = math.sqrt(ta.sma(up1 * up1, volLen)) * math.sqrt(2.0) * close
sigDnB = math.sqrt(ta.sma(dn1 * dn1, volLen)) * math.sqrt(2.0) * close
sigS   = math.max(sigBar / math.sqrt(60.0), 0.5)                          // $ per √s
atr    = ta.atr(atrLen)
atrAvg = ta.sma(atr, 100)
volDanger = atr > atrAvg * atrMult
range3 = ta.highest(high, 3) - ta.lowest(low, 3)
twap   = ta.sma(close, twapLen)

// ─────────────────── Velocity / acceleration (the physics view) ───────────────────
rawVel = (close - close[velLen]) / velLen
vel    = ta.ema(rawVel, smoothLen)                 // $ per bar
accEma = ta.ema(ta.change(vel), smoothLen)
velS   = vel / 60.0                                // $ per second
proj(p, v, a, t) => p + v * t + 0.5 * a * t * t

// ─────────────────── Record pace: the most BTC has ever moved in 1…15 minutes ───────────────────
// Moves are kept as a fraction of price so old history scales to today's price. Every horizon comes
// from the chart's own 1-min bars (all the history TradingView loads: the move from the close before
// an h-bar window to the highest high / lowest low inside it); the 5 / 10 / 15-minute horizons are
// also checked against 5-min and 15-min bars, which reach back hundreds of days. Up and down are
// tracked separately: BTC falls faster than it rises.
upRec(h) => ta.max(nz((ta.highest(high, h) - close[h]) / close[h]))
dnRec(h) => ta.max(nz((close[h] - ta.lowest(low, h)) / close[h]))
rUp1  = upRec(1)
rUp2  = upRec(2)
rUp3  = upRec(3)
rUp4  = upRec(4)
rUp5  = upRec(5)
rUp6  = upRec(6)
rUp7  = upRec(7)
rUp8  = upRec(8)
rUp9  = upRec(9)
rUp10 = upRec(10)
rUp11 = upRec(11)
rUp12 = upRec(12)
rUp13 = upRec(13)
rUp14 = upRec(14)
rUp15 = upRec(15)
rDn1  = dnRec(1)
rDn2  = dnRec(2)
rDn3  = dnRec(3)
rDn4  = dnRec(4)
rDn5  = dnRec(5)
rDn6  = dnRec(6)
rDn7  = dnRec(7)
rDn8  = dnRec(8)
rDn9  = dnRec(9)
rDn10 = dnRec(10)
rDn11 = dnRec(11)
rDn12 = dnRec(12)
rDn13 = dnRec(13)
rDn14 = dnRec(14)
rDn15 = dnRec(15)
[rUp5b, rUp10b, rUp15b, rDn5b, rDn10b, rDn15b, bars5] = request.security(syminfo.tickerid, "5",
     [ta.max(nz((high - close[1]) / close[1])),
      ta.max(nz((ta.highest(high, 2) - close[2]) / close[2])),
      ta.max(nz((ta.highest(high, 3) - close[3]) / close[3])),
      ta.max(nz((close[1] - low) / close[1])),
      ta.max(nz((close[2] - ta.lowest(low, 2)) / close[2])),
      ta.max(nz((close[3] - ta.lowest(low, 3)) / close[3])),
      bar_index])
[rUp15c, rDn15c, bars15] = request.security(syminfo.tickerid, "15",
     [ta.max(nz((high - close[1]) / close[1])), ta.max(nz((close[1] - low) / close[1])), bar_index])
// dollars reachable by minute 0…15 at record pace (index = minutes), never shrinking with the horizon
recTable(up) =>
    f = up ? array.from(0.0, rUp1, rUp2, rUp3, rUp4, rUp5, rUp6, rUp7, rUp8, rUp9, rUp10, rUp11, rUp12, rUp13, rUp14, rUp15) : array.from(0.0, rDn1, rDn2, rDn3, rDn4, rDn5, rDn6, rDn7, rDn8, rDn9, rDn10, rDn11, rDn12, rDn13, rDn14, rDn15)
    array.set(f, 5,  math.max(array.get(f, 5),  up ? rUp5b  : rDn5b))
    array.set(f, 10, math.max(array.get(f, 10), up ? rUp10b : rDn10b))
    array.set(f, 15, math.max(array.get(f, 15), up ? rUp15b : rDn15b, up ? rUp15c : rDn15c))
    for h = 1 to 15
        array.set(f, h, math.max(array.get(f, h), array.get(f, h - 1)))
    for h = 0 to 15
        array.set(f, h, array.get(f, h) * close * recScale)
    f
// minutes needed to cover `dist` dollars at record pace (interpolated); na = more than 15 minutes, never seen
needMins(dist, rec) =>
    float t = na
    if dist <= 0
        t := 0.0
    else
        for h = 1 to 15
            a = array.get(rec, h - 1)
            b = array.get(rec, h)
            if b >= dist
                t := (h - 1) + (b > a ? (dist - a) / (b - a) : 0.0)
                break
    t
// the most BTC has moved in `mins` minutes (fractional), at record pace
recAt(mins, rec) =>
    float out = 0.0
    if mins >= 15
        out := array.get(rec, 15)
    else if mins > 0
        k = int(math.floor(mins))
        lo = array.get(rec, k)
        hi = array.get(rec, k + 1)
        out := lo + (hi - lo) * (mins - k)
    out

// ─────────────────── Settlement average: mean and sd at time `atMs` ───────────────────
// S = offset + mean(spot over [T-62, T-2]).  Known part from the tick buffer (or the bar blend), future part
// from the current spot with momentum credited for at most 45 s; sd from Brownian motion.
settle(atMs, spot, sig) =>
    wStart = roundEnd - (WIN + DELAY) * 1000
    wEnd   = roundEnd - DELAY * 1000
    rp     = (wEnd - atMs) / 1000.0
    float mean = na
    float sd = na
    float known = 0.0
    if rp <= 0
        [a, c] = tickAvg(wStart, wEnd)
        mean := offset + (c >= 0.9 ? a : barAvg)
        sd := 0.0
        known := 1.0
    else if rp >= WIN
        driftH = math.min(math.max(rp - WIN / 2.0, 0.0), 45.0)
        mean := offset + spot + driftW * velS * driftH
        sd := sig * math.sqrt(rp - WIN + WIN / 3.0)
    else
        [a, c] = tickAvg(wStart, atMs)
        knownAvg = c >= 0.8 ? a : barAvg
        known := (WIN - rp) / WIN
        futMean = spot + driftW * velS * (rp / 2.0)
        mean := offset + known * knownAvg + (rp / WIN) * futMean
        sd := sig * math.sqrt(rp * rp * rp / 3.0) / WIN
    [mean, sd, known]

[sMean, sSd, sKnown] = settle(nowMs, close, sigS)
gap  = sMean - target                       // settlement mean vs target (+ = UP side)
zS   = sSd > 0 ? gap / sSd : (gap >= 0 ? 99.0 : -99.0)
pUp  = sSd > 0 ? fPhi(zS) : (gap >= 0 ? 1.0 : 0.0)
pDn  = 1.0 - pUp
lean = pUp >= 0.5 ? 1 : -1
favTxt = lean > 0 ? "UP" : "DOWN"
pFav = lean > 0 ? pUp : pDn
// conservative survival probability for the leaning side, using the adverse-side vol
sigAdvB = lean > 0 ? sigDnB : sigUpB
sigAdvS = math.max(sigAdvB / math.sqrt(60.0), 0.5)
[sMeanA, sSdA, sKnownA] = settle(nowMs, close, sigAdvS)
pSafe = sSdA > 0 ? fPhi(math.abs(sMeanA - target) / sSdA) : 1.0
dev   = close + offset - target             // basis-adjusted spot vs target
lead  = math.abs(dev)

// ─────────────────────── Market price vs fair, edge, lock ───────────────────────
lockP   = lockPct / 100.0
mktFav  = lean > 0 ? mktUp : mktDn
favAsk  = mktFav > 0 ? mktFav / 100.0 : float(na)
hasAsk  = not na(favAsk)
lockNet = hasAsk ? pFav - favAsk - fee(favAsk) : float(na)
isLocked = pFav >= lockP
lockBuyable = isLocked and (not hasAsk or favAsk <= maxLock / 100.0)

// ─────────────────────── Alpha conviction lights (6) ───────────────────────
twapC   = twap[1]
slopeT  = twapC - twap[4]
slopeP  = close[1] - close[4]
cleanRun = (slopeT > 0 and slopeP > 0 and close[1] > twapC) or (slopeT < 0 and slopeP < 0 and close[1] < twapC)
revRisk  = (slopeT > 0 and close[1] < twapC) or (slopeT < 0 and close[1] > twapC)
l1 = lead >= buffer
l2 = lean > 0 ? twap + offset > target + buffer : twap + offset < target - buffer
l3 = cleanRun
l4 = not volDanger and range3 < lead
l5 = pSafe >= safeP
sidePx = hasAsk ? favAsk : pFav
l6 = sidePx <= maxAskA
conv = (l1 ? 1 : 0) + (l2 ? 1 : 0) + (l3 ? 1 : 0) + (l4 ? 1 : 0) + (l5 ? 1 : 0) + (l6 ? 1 : 0)
inWindow = minsElapsed >= entryFrom and minsElapsed < entryTo
lateKill = secsLeft <= killSecs
inChop   = lead < chopBand
efCheck  = useEF and ((secsElapsed >= 110 and secsElapsed <= 150) or (secsElapsed >= 170 and secsElapsed <= 210))
efOk     = efCheck and hasAsk and favAsk * 100 >= efLo and favAsk * 100 <= efHi

// ─────────────────────── Position ───────────────────────
posDir  = posSide == "Up" ? 1 : posSide == "Down" ? -1 : 0
pMine   = posDir > 0 ? pUp : posDir < 0 ? pDn : float(na)
posShares = posDir != 0 ? posUsd / (posEntry / 100.0) : 0.0
posVal  = posDir != 0 ? posShares * pMine : float(na)
posPnl  = posDir != 0 ? posVal - posUsd : float(na)

// ─────────────────────── ETAs (last bar only; assume the spot holds) ───────────────────────
var float lockEta = na
var float flipEta = na
if barstate.islast
    lockEta := na
    flipEta := na
    if not isLocked and secsLeft > 3
        for s = 2 to int(math.min(secsLeft, 600)) by 2
            [m2, d2, k2] = settle(nowMs + s * 1000, close, sigS)
            pu2 = d2 > 0 ? fPhi((m2 - target) / d2) : (m2 >= target ? 1.0 : 0.0)
            pf2 = lean > 0 ? pu2 : 1.0 - pu2
            if pf2 >= lockP
                lockEta := s
                break
    if secsLeft > 3 and math.abs(velS) > 0.02 and math.sign(velS) == -math.sign(gap)
        for s = 2 to int(math.min(secsLeft, 600)) by 2
            [m3, d3, k3] = settle(nowMs + s * 1000, close + velS * s, sigS)
            if math.sign(m3 - target) != math.sign(gap)
                flipEta := s
                break

// ─────────────────────── Reach: record pace vs the time left (last bar only) ───────────────────────
// How long BTC would need to reach the target at the fastest it has ever moved in that direction, and
// whether that fits in the time left. Red = it does not fit even at record pace. The other three tiers
// use the touch odds: the chance a path with today's adverse-side vol touches the target before the bell.
needMove  = target - offset - close                 // $ the spot must move (+ = up)
var float reachMins = na
var float reachOdds = na
var float recLeft   = na
var int   reachTier = 0
var string reachWord = "NOT POSSIBLE"
if barstate.islast and not na(target)
    rec = recTable(needMove >= 0)
    reachMins := needMins(math.abs(needMove), rec)
    recLeft   := recAt(secsLeft / 60.0, rec)
    sigDirS = math.max((needMove >= 0 ? sigUpB : sigDnB) / math.sqrt(60.0), 0.5)
    zT = secsLeft > 0 ? math.abs(needMove) / (sigDirS * math.sqrt(secsLeft)) : 99.0
    reachOdds := math.min(1.0, 2.0 * (1.0 - fPhi(zT)))
    reachTier := secsLeft <= 0 or na(reachMins) or reachMins > secsLeft / 60.0 ? 0 : reachOdds < reachYellow / 100.0 ? 1 : reachOdds < reachGreen / 100.0 ? 2 : 3
    reachWord := reachTier == 0 ? "NOT POSSIBLE" : reachTier == 1 ? "UNLIKELY" : reachTier == 2 ? "EASILY" : "MOST LIKELY"
reachCol  = reachTier == 0 ? colBad : reachTier == 1 ? colWarn : reachTier == 2 ? colEasy : colOk
reachMinsTxt = na(reachMins) ? "> 15 min" : reachMins < 0.1 ? "< 0.1 min" : fmt1(reachMins) + " min"

// ─────────────────────── The command ───────────────────────
string cmd = "WAIT"
string why = ""
string timing = ""
color  cmdCol = color.new(color.gray, 60)
string grade = pFav >= 0.995 ? "A+" : pFav >= 0.99 ? "A" : pFav >= 0.97 ? "B" : pFav >= 0.90 ? "C" : "D"
if na(target)
    cmd := "WAITING FOR THE FIRST ROUND BOUNDARY"
    why := "The target is estimated from the minute before the open."
else if secsLeft <= 0
    cmd := "ROUND OVER — SETTLING"
    why := "Next target = this round's settlement average."
else if posDir != 0
    posWord = posDir > 0 ? "UP" : "DOWN"
    if pMine >= lockP
        cmd := "HOLD " + posWord + " — LOCKED " + pctTxt(pMine)
        why := "Ride it to the bell. Selling now only gives up the last cents."
        timing := "Settles in " + fmtClock(secsLeft)
        cmdCol := color.new(colOk, 40)
    else if pMine < 0.5
        cmd := "SELL " + posWord + " NOW"
        why := favTxt + " leads. Your side is " + pctTxt(pMine) + ". Take the bid."
        timing := "Settles against you in " + fmtClock(secsLeft)
        cmdCol := color.new(colBad, 15)
    else if pMine < 0.90
        cmd := "SELL HALF of " + posWord
        why := "Lock broke: " + pctTxt(pMine) + ". The settlement average sits only $" + fmt1(math.abs(gap)) + " from the target."
        timing := not na(flipEta) ? "Flips in ~" + secsTxt(flipEta) + " at this pace" : "You have " + fmtClock(secsLeft)
        cmdCol := color.new(colBad, 30)
    else
        cmd := "HOLD " + posWord + " (" + grade + ")"
        why := pctTxt(pMine) + ". " + (not na(lockEta) ? "Locks in ~" + secsTxt(lockEta) + " if the price holds." : "Not locked yet; watch the gap.")
        timing := "Settles in " + fmtClock(secsLeft)
        cmdCol := color.new(colPM, 60)
else if volDanger
    cmd := "STAND DOWN — MARKET TOO WILD"
    why := "ATR is " + fmt1(atr / atrAvg) + "× its average. Locks are not trustworthy in a spike."
    timing := "Round ends in " + fmtClock(secsLeft)
    cmdCol := color.new(color.maroon, 10)
else if lockBuyable and secsLeft > 4
    payUp = hasAsk ? favAsk : maxLock / 100.0
    net   = pFav - payUp - fee(payUp)
    kelly = math.max(0.0, pFav - (1.0 - pFav) * payUp / (1.0 - payUp))
    cmd := "FREE MONEY — BUY " + favTxt + (hasAsk ? " AT " + fmt0(favAsk * 100) + "¢" : " UP TO " + str.tostring(maxLock) + "¢")
    why := "Locked " + pctTxt(pFav) + ": the average needs $" + fmt1(math.abs(gap)) + " against a $" + fmt1(sSd * 3) + " 3σ range. +" + str.tostring(net * 100, "#.#") + "¢/share after fee. Kelly " + fmt0(kelly * 100) + "% — cap at 10–20%."
    timing := "You have " + fmtClock(math.max(0.0, secsLeft - 5)) + " to get filled · ride to the bell"
    cmdCol := color.new(colOk, 10)
else if isLocked and hasAsk
    cmd := favTxt + " LOCKED BUT PRICED AT " + fmt0(favAsk * 100) + "¢"
    why := "Above your " + str.tostring(maxLock) + "¢ max. Net would be " + str.tostring(lockNet * 100, "#.#") + "¢/share."
    timing := "Settles in " + fmtClock(secsLeft)
    cmdCol := color.new(colWarn, 40)
else if lateKill
    cmd := "ROUND ENDING — NO NEW BUYS"
    why := favTxt + " " + pctTxt(pFav) + ". " + fmt0(sKnown * 100) + "% of the settlement average is in the books."
    timing := "Bell in " + fmtClock(secsLeft)
    cmdCol := color.new(color.purple, 30)
else if efOk
    cmd := "EF RULE — BUY " + favTxt + " AT " + fmt0(favAsk * 100) + "¢ AND HOLD"
    why := "Tested Oct 6–22: favorite at " + str.tostring(efLo) + "–" + str.tostring(efHi) + "¢ at 13:00 / 12:00 left, hold to the end. Model odds " + pctTxt(pFav) + " (" + grade + ")."
    timing := "Check window closes in " + secsTxt(secsElapsed < 160 ? 150 - secsElapsed : 210 - secsElapsed)
    cmdCol := color.new(colPM, 20)
else if efCheck
    cmd := "EF CHECK — " + favTxt + " " + pctTxt(pFav) + ": buy only if the button shows " + str.tostring(efLo) + "–" + str.tostring(efHi) + "¢"
    why := hasAsk ? "Typed ask " + fmt0(favAsk * 100) + "¢ is outside the band." : "Type the ask in settings, or read it off the button."
    timing := "Check window closes in " + secsTxt(secsElapsed < 160 ? 150 - secsElapsed : 210 - secsElapsed)
    cmdCol := color.new(colPM, 55)
else if pFav >= 0.97
    cmd := "GET READY — " + favTxt + " " + pctTxt(pFav)
    why := "Nearly locked. It locks when the gap holds while the settlement window fills in."
    timing := not na(lockEta) ? "Locks in ~" + secsTxt(lockEta) + " if the price holds" : "Needs a bigger gap first"
    cmdCol := color.new(colWarn, 35)
else if useAlpha and inWindow and not inChop and conv >= minConv
    cmd := "BUY " + favTxt + " — " + str.tostring(conv) + " of 6 lights (" + grade + ")"
    why := "Alpha gate. Model odds " + pctTxt(pFav) + ", safe " + pctTxt(pSafe) + " on adverse vol" + (hasAsk ? ", ask " + fmt0(favAsk * 100) + "¢" : "") + "."
    timing := not na(lockEta) ? "Could lock in ~" + secsTxt(lockEta) : "Round ends in " + fmtClock(secsLeft)
    cmdCol := lean > 0 ? color.new(colOk, 45) : color.new(colBad, 45)
else if inChop
    cmd := "WAIT — PRICE IS HUGGING THE TARGET"
    why := favTxt + " " + pctTxt(pFav) + " (" + grade + "). A coin flip until the gap opens."
    timing := "Round ends in " + fmtClock(secsLeft)
    cmdCol := color.new(colWarn, 70)
else
    cmd := "WAIT — " + favTxt + " " + pctTxt(pFav) + " (" + grade + ")"
    why := useAlpha and inWindow ? str.tostring(conv) + " of 6 lights. Buying here is a " + grade + " play; the locked one usually shows up inside the last 2 minutes." : "Outside the entry window. The locked play usually shows up inside the last 2 minutes."
    timing := not na(lockEta) ? "Could lock in ~" + secsTxt(lockEta) + " if the price holds" : "Round ends in " + fmtClock(secsLeft)
    cmdCol := color.new(color.gray, 70)

// ─────────────────────── Chart layers ───────────────────────
plot(showPM ? pmShown : na, "Polymarket shows (60-s avg)", color = colPM, linewidth = 2)
plot(showTwap ? twap : na, "TWAP", color = color.new(color.green, 40), linewidth = 1)
// round shading + settlement window
roundIdx = int(roundStart / roundMs)
slot = roundIdx % 4
hueCol = slot == 0 ? color.rgb(41, 121, 255) : slot == 1 ? color.rgb(171, 71, 188) : slot == 2 ? color.rgb(0, 172, 193) : color.rgb(255, 167, 38)
isCurRound = roundStart == math.floor(timenow / 900000.0) * roundMs
inSettleWin = secsLeft <= WIN + DELAY and secsLeft > 0
bgcolor(shadeRounds ? color.new(hueCol, isCurRound ? 84 : 91) : na, title = "Round shading")
bgcolor(inSettleWin ? color.new(colPM, 80) : na, title = "Settlement window (last 60 s)")
var array<line> marks = array.new<line>()
if shadeRounds and isNewRound
    array.push(marks, line.new(roundStart, close, roundStart, close + syminfo.mintick, xloc = xloc.bar_time, extend = extend.both, color = color.new(hueCol, 30), style = line.style_dashed, width = 1))
    if array.size(marks) > 60
        line.delete(array.shift(marks))

var line  tgtLine = na
var label tgtLbl  = na
var label tgtTag  = na
var line  postLine = na
var label postLbl  = na
var array<line>  tick = array.new<line>()
var array<label> tickL = array.new<label>()
if barstate.islast and not na(target)
    line.delete(tgtLine)
    label.delete(tgtLbl)
    label.delete(tgtTag)
    line.delete(postLine)
    label.delete(postLbl)
    for l in tick
        line.delete(l)
    array.clear(tick)
    for lb in tickL
        label.delete(lb)
    array.clear(tickL)
    tgtPlot = target - offset                       // plotted in spot dollars (basis-adjusted) so it sits where the candles live
    tgtLine := line.new(bar_index - 100, tgtPlot, bar_index + 20, tgtPlot, xloc = xloc.bar_index, extend = extend.both, color = colTgt, style = line.style_dashed, width = 3)
    tgtLbl  := label.new(bar_index + 16, tgtPlot, "TARGET " + fmtP(target) + "  (" + tgtSrc + ")", xloc = xloc.bar_index, style = label.style_label_left, color = colTgt, textcolor = color.black, size = size.normal)
    tgtTag  := label.new(bar_index - 2, tgtPlot, (dev >= 0 ? "spot $" + fmt1(lead) + " above ▲" : "spot $" + fmt1(lead) + " below ▼"), xloc = xloc.bar_index, style = dev >= 0 ? label.style_label_down : label.style_label_up, color = color.new(colTgt, 40), textcolor = color.black, size = size.small)
    if showPost
        xp = bar_index + 3
        postLine := line.new(xp, close, xp, tgtPlot, xloc = xloc.bar_index, color = colPost, width = 4)
        dirP = tgtPlot >= close ? 1 : -1
        float run = close
        maxM = int(math.max(1.0, math.min(15.0, math.ceil(secsLeft / 60.0))))
        for m = 1 to maxM
            p = proj(close, vel, accEma, m)
            if (p - run) * dirP <= 0
                break
            run := p
            if (p - tgtPlot) * dirP > 0
                break
            array.push(tick, line.new(xp - 1, p, xp + 1, p, xloc = xloc.bar_index, color = color.new(colPost, 20), width = 2))
            array.push(tickL, label.new(xp + 1, p, str.tostring(m) + "m", xloc = xloc.bar_index, style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.new(colPost, 20), size = size.small))
        // the label between the spot and the target: minutes to get there at BTC's record pace, judged against the time left
        postLbl := label.new(xp, (close + tgtPlot) / 2, reachMinsTxt + " at record pace\n" + reachWord + " · " + fmtClock(secsLeft) + " left", xloc = xloc.bar_index, style = label.style_label_left, color = color.new(reachCol, 0), textcolor = reachTier >= 2 ? color.black : color.white, size = size.small)

// ─────────────────────── HUD ───────────────────────
var table hud = table.new(tblPos(hudPos), 1, 10, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.new(color.gray, 70))
row(r, txt, c, bg) =>
    table.cell(hud, 0, r, txt, text_color = c, text_size = hudTxt, text_halign = text.align_left, bgcolor = bg)
if barstate.islast
    // momentum view: does the current path even reach the target, and when (never a probability)
    pathTxt = "momentum: " + (math.sign(velS) == math.sign(needMove) and math.abs(velS) > 0.01 ? "crosses in ~" + secsTxt(math.abs(needMove / velS)) + " at this pace" : "not on this path") + " · v " + (vel >= 0 ? "+" : "") + fmt1(vel) + "/bar · a " + (accEma >= 0 ? "+" : "") + str.tostring(accEma, "#.##")
    upTxt = "UP " + fmt0(pUp * 100) + "¢ fair" + (mktUp > 0 ? " (mkt " + fmt0(mktUp) + ", edge " + (pUp * 100 - mktUp >= 0 ? "+" : "") + fmt0(pUp * 100 - mktUp) + ")" : "")
    dnTxt = "DOWN " + fmt0(pDn * 100) + "¢ fair" + (mktDn > 0 ? " (mkt " + fmt0(mktDn) + ", edge " + (pDn * 100 - mktDn >= 0 ? "+" : "") + fmt0(pDn * 100 - mktDn) + ")" : "")
    lights = (l1 ? "Lead ✓" : "Lead ✗") + "  " + (l2 ? "Trend ✓" : "Trend ✗") + "  " + (l3 ? "Momentum ✓" : "Momentum ✗") + "  " + (l4 ? "Calm ✓" : "Calm ✗") + "  " + (l5 ? "Safe ✓" : "Safe ✗") + "  " + (l6 ? "Headroom ✓" : "Headroom ✗") + "  (" + str.tostring(conv) + "/6)"
    posTxt = posDir != 0 ? "In " + (posDir > 0 ? "UP" : "DOWN") + " @" + fmt0(posEntry) + "¢ $" + fmt0(posUsd) + " → worth $" + fmt0(posVal) + " (" + (posPnl >= 0 ? "+$" : "−$") + fmt0(math.abs(posPnl)) + ") · to win $" + fmt0(posShares) : "No position — set Side in settings after you buy"
    row(0, cmd, color.white, cmdCol)
    row(1, timing, color.yellow, color.new(color.black, 100))
    row(2, why, color.white, color.new(color.black, 100))
    row(3, fmtClock(secsLeft) + " left · " + favTxt + " ahead · spot $" + fmt1(lead) + " " + (dev >= 0 ? "above" : "below") + " · PM shows $" + fmt1(math.abs(pmShown - target)) + " " + (pmShown >= target ? "above" : "below") + " · target " + fmtP(target) + " (" + tgtSrc + ")", color.silver, color.new(color.black, 100))
    row(4, "ODDS  UP " + pctTxt(pUp) + " · DOWN " + pctTxt(pDn) + " · safe " + pctTxt(pSafe) + " (adverse vol) · avg " + (gap >= 0 ? "+$" : "−$") + fmt1(math.abs(gap)) + " vs target, 3σ $" + fmt1(sSd * 3) + (inSettleWin ? " · " + fmt0(sKnown * 100) + "% in the books" : ""), pFav >= lockP ? colOk : color.white, color.new(color.black, 100))
    row(5, upTxt + "   " + dnTxt, color.white, color.new(color.black, 100))
    row(6, lights, conv >= minConv ? colOk : color.silver, color.new(color.black, 100))
    row(7, posTxt, posDir != 0 ? color.white : color.gray, posDir != 0 ? (pMine >= lockP ? color.new(colOk, 70) : pMine < 0.5 ? color.new(colBad, 60) : color.new(color.black, 100)) : color.new(color.black, 100))
    row(8, pathTxt + " · last 3 min range $" + fmt0(range3) + " · adverse swing $" + fmt0(sigAdvB) + "/min" + (volDanger ? " · WILD" : cleanRun ? " · clean trend" : revRisk ? " · turning" : ""), color.silver, color.new(color.black, 100))
    reachTxt = "REACH  " + reachWord + " — the target is $" + fmt0(math.abs(needMove)) + " " + (needMove >= 0 ? "up" : "down") + ": " + reachMinsTxt + " at record pace vs " + fmtClock(secsLeft) + " left · touch odds " + pctTxt(reachOdds) + " · record move in that time $" + fmt0(recLeft) + " · history " + fmt0(bar_index / 1440.0) + "d 1-min, " + fmt0(bars5 / 288.0) + "d 5-min, " + fmt0(bars15 / 96.0) + "d 15-min"
    row(9, reachTxt, reachCol, color.new(color.black, 100))

// ─────────────────────── Alerts ───────────────────────
lockOn = lockBuyable and posDir == 0 and secsLeft > 4
alertcondition(lockOn and not lockOn[1], "FREE MONEY: locked favorite for sale", "PM15 Brain: locked favorite under your max — buy and ride to the bell")
alertcondition(efOk and not efOk[1], "EF rule fires", "PM15 Brain: Early Favorite rule — buy the favorite and hold")
alertcondition(posDir != 0 and pMine < 0.5 and pMine[1] >= 0.5, "SELL NOW", "PM15 Brain: your side is no longer the favorite")
alertcondition(posDir != 0 and pMine < 0.9 and pMine[1] >= 0.9, "Lock broke", "PM15 Brain: lock broke — consider selling half")
if lockOn and not lockOn[1]
    alert("PM15 Brain: FREE MONEY — buy " + favTxt + (hasAsk ? " at " + fmt0(favAsk * 100) + "¢" : "") + ", " + pctTxt(pFav) + ", " + fmtClock(secsLeft) + " left", alert.freq_once_per_bar)
if posDir != 0 and pMine < 0.5 and pMine[1] >= 0.5
    alert("PM15 Brain: SELL " + (posDir > 0 ? "UP" : "DOWN") + " now — " + favTxt + " leads, " + fmtClock(secsLeft) + " left", alert.freq_once_per_bar)
