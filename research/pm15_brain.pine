//@version=6
// =============================================================================
//  PM15 BRAIN  v2.0 — Polymarket US 15-minute BTC Up/Down · 1-min Coinbase BTC-USD
//  ---------------------------------------------------------------------------
//  What settles the market (Polymarket US rules, checked Oct 31 2026): the
//  average of 60 one-second CF Benchmarks BRTI readings in the last minute
//  before each quarter-hour; price to beat = last round's settlement. During
//  the final minute part of the result is already in the books — the only
//  "future" anyone can know. BTC's own direction over the next 30 s is not
//  predictable and this script never pretends it is.
//
//  v2.0 vs v1.2
//   • KILL LINE (red): the level BTC must AVERAGE for the rest of the settlement
//     window to flip the result. It runs away from spot as the window fills.
//     Cushion = spot → kill line. This is the hold/sell number.
//   • LOOKAHEAD: where the PM line will read in 30 s if BTC holds (32 of those
//     60 s are already known) ±1σ — dotted stub + dot on the chart; BTC's move
//     over the last 10 s / 30 s from live ticks. The 14-bar velocity could not
//     see a flash move; it now only drives the momentum post.
//   • In a position the verdict is one word — LOCKED (hold, ignore the button),
//     HOLD, SELL. SELL = model win chance under your floor, or BTC's last-10-s
//     pace reaches the kill line within N s, or (last 2 min) the cushion is
//     thinner than a 1-in-100-minutes adverse move, or the typed bid pays more
//     than the math. SELL NOW = settlement already projected against you.
//     v1.2 fired GET OUT the moment spot crossed the target even when the
//     average was already locked (that was the panic sell), never checked the
//     cushion inside the last minute, and fired GET OUT under 85% — right after
//     an EF buy at 85¢.
//   • LOCKED needs cushion > record move for the time left × margin + target
//     error + index-vs-Coinbase slack. Settlement window = [bell−60 s, bell];
//     the 2-s display lag only moves the PM line (v1.2 cut 2 s off the window).
//   • Typed inputs belong to the round you typed them in: a target >0.15% from
//     the estimate is ignored as stale; asks, bid and Side are dropped when the
//     round changes. The learned basis offset only comes from a tick-grade
//     estimate and is clamped ±$50. The HUD shows target quality.
//   • Momentum credit in the odds defaults to 0 (no evidence it predicts).
//   • UI: HUD wraps (v1.2 rows ran to 300 chars and covered the chart), 7 rows
//     + optional tech; everything drawn in chart dollars (v1.2 plotted the PM
//     line offset from the target line); labels hug the last bar; the post
//     keeps its minute ticks with one small label; the lock-ETA search no
//     longer re-scans the tick buffer 300× per tick.
//  Language rules unchanged: "100%" only when LOCKED; UP / DOWN are "for now".
// =============================================================================
indicator("PM15 Brain", shorttitle = "PM15 Brain", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ─────────────────────────────── Inputs ───────────────────────────────
gT = "Target (price to beat)"
tgtTyped = input.float(0.0, "Target from the PM screen ($, 0 = estimate it)", step = 0.01, group = gT)
tgtAdj   = input.float(0.0, "Basis offset ($) = PM price − Coinbase (used until one is learned)", step = 0.5, group = gT, display = display.none)
tgtSlack = input.float(5.0, "Index-vs-Coinbase slack ($) the cushion must also beat before LOCKED", minval = 0, step = 1, group = gT, display = display.none)

gM = "Market (type what Polymarket shows — this round only)"
mktUp   = input.float(0.0, "UP ask (¢, 0 = off)", minval = 0, maxval = 100, step = 1, group = gM, display = display.none)
mktDn   = input.float(0.0, "DOWN ask (¢, 0 = off)", minval = 0, maxval = 100, step = 1, group = gM, display = display.none)
maxLock = input.int(97, "Max to pay for a SURE THING (¢)", minval = 50, maxval = 99, group = gM, display = display.none)
feeCoef = input.float(0.0695, "Taker fee coefficient", minval = 0, maxval = 0.2, step = 0.0005, group = gM, display = display.none)

gP = "In position (set after you buy — this round only)"
posSide  = input.string("None", "Side", options = ["None", "Up", "Down"], group = gP, display = display.none)
posEntry = input.float(78.0, "Entry price (¢)", step = 1, minval = 1, maxval = 99, group = gP, display = display.none)
posUsd   = input.float(20.0, "Dollars in", step = 10, group = gP, display = display.none)
posBid   = input.float(0.0, "SELL button shows (¢, 0 = unknown)", minval = 0, maxval = 100, step = 1, group = gP, display = display.none)

gX = "Hold / sell"
holdMinP = input.int(75, "SELL when the model win chance drops under (%)", minval = 50, maxval = 95, group = gX, display = display.none)
etaWarnS = input.int(30, "SELL when BTC's last-10-s pace would reach the kill line within (s)", minval = 5, maxval = 120, group = gX, display = display.none)
badPct   = input.int(99, "Last 2 min: SELL if the cushion is under this percentile of 1-min adverse moves (24 h)", minval = 90, maxval = 100, group = gX, display = display.none)
lookS    = input.int(30, "Lookahead for the PM line (s)", minval = 10, maxval = 60, group = gX, display = display.none)

gE = "Entry rules (no position)"
useEF    = input.bool(true, "Early Favorite rule: at 13:00 / 12:00 left buy the favorite if it shows 80–94¢", group = gE, display = display.none)
efLo     = input.int(80, "EF: favorite ask at least (¢)", minval = 50, maxval = 98, group = gE, display = display.none)
efHi     = input.int(94, "EF: and at most (¢)", minval = 51, maxval = 99, group = gE, display = display.none)
useAlpha = input.bool(true, "Alpha conviction gate (lights in the tech rows)", group = gE, display = display.none)
minConv  = input.int(5, "Alpha: lights needed (of 6)", minval = 1, maxval = 6, group = gE, display = display.none)
buffer   = input.float(20.0, "Alpha: lead / TWAP buffer vs target ($)", step = 1, group = gE, display = display.none)
chopBand = input.float(10.0, "Alpha: chop band ($)", step = 1, group = gE, display = display.none)
entryFrom = input.float(3.0, "Alpha: window opens (min elapsed)", step = 0.25, group = gE, display = display.none)
entryTo   = input.float(13.75, "Alpha: window closes (min elapsed)", step = 0.25, group = gE, display = display.none)
killSecs  = input.int(45, "No new buys in the last (sec)", minval = 0, maxval = 300, group = gE, display = display.none)
safeP     = input.float(0.80, "Alpha light 5: adverse-vol P(win) at least", step = 0.05, minval = 0.5, maxval = 0.99, group = gE, display = display.none)
maxAskA   = input.float(0.85, "Alpha light 6: max price you will pay", step = 0.01, minval = 0.05, maxval = 0.99, group = gE, display = display.none)
twapLen   = input.int(15, "TWAP window (bars)", minval = 3, group = gE, display = display.none)
atrLen    = input.int(14, "ATR length", group = gE, display = display.none)
atrMult   = input.float(2.5, "Stand down if ATR > x · ATR avg(100)", step = 0.1, group = gE, display = display.none)
volLen    = input.int(60, "Realised-vol window (bars)", minval = 10, group = gE, display = display.none)

gV = "Model"
dispLag  = input.int(2, "PM line display lag (s) — display only; the settlement window ends at the bell", minval = 0, maxval = 10, group = gV, display = display.none)
driftW   = input.float(0.0, "Momentum credited in the odds (0–1; 0 recommended)", minval = 0, maxval = 1, step = 0.1, group = gV, display = display.none)
recScale = input.float(1.5, "LOCKED margin (× the biggest move in the loaded history)", minval = 1.0, maxval = 3.0, step = 0.1, group = gV, display = display.none)
reachGreen  = input.int(50, "Post: MOST LIKELY when the touch odds are at least (%)", minval = 1, maxval = 99, group = gV, display = display.none)
reachYellow = input.int(10, "Post: EASILY when the touch odds are at least (%) — below that UNLIKELY; beyond the record NOT POSSIBLE", minval = 1, maxval = 99, group = gV, display = display.none)
velLen    = input.int(14, "Post: velocity lookback (bars)", minval = 1, group = gV, display = display.none)
smoothLen = input.int(5, "Post: smoothing (EMA)", minval = 1, group = gV, display = display.none)

gH = "HUD / chart"
hudPos   = input.string("Top left", "HUD position", options = ["Top left", "Top right", "Middle left", "Middle right", "Bottom left", "Bottom right"], group = gH, display = display.none)
hudSize  = input.string("small", "HUD text size", options = ["tiny", "small", "normal", "large"], group = gH, display = display.none)
hudW     = input.int(44, "HUD line width (characters)", minval = 24, maxval = 90, group = gH, display = display.none)
hudCompact = input.bool(false, "Compact HUD (verdict, timing, why, lookahead, kill)", group = gH, display = display.none)
showTech = input.bool(false, "Show the technical rows", group = gH, display = display.none)
showKill = input.bool(true, "Kill line", group = gH, display = display.none)
showAhead = input.bool(true, "PM line lookahead stub", group = gH, display = display.none)
showPost = input.bool(true, "Momentum post with minute ticks", group = gH, display = display.none)
showPM   = input.bool(true, "PM line (60-s average, chart dollars)", group = gH, display = display.none)
showTwap = input.bool(false, "TWAP line", group = gH, display = display.none)
shadeRounds = input.bool(true, "Shade rounds and mark each 15-min boundary", group = gH, display = display.none)

gC = "Colors"
colTgt  = input.color(#ffb020, "Target line", group = gC)
colKill = input.color(#ff4b5c, "Kill line", group = gC)
colPM   = input.color(#62ccff, "PM line", group = gC)
colPost = input.color(#b57cff, "Momentum post", group = gC)
colOk   = input.color(#28d978, "Good", group = gC)
colEasy = input.color(#ffe14d, "Caution (yellow)", group = gC)
colWarn = input.color(#ff8a1f, "Warning (orange)", group = gC)
colBad  = input.color(#ff4b5c, "Bad", group = gC)

// ─────────────────────────────── Helpers ───────────────────────────────
WIN = 60
fmtP(x) => str.tostring(x, "#,###.00")
fmt0(x) => str.tostring(x, "#")
fmt1(x) => str.tostring(x, "#.#")
fmtClock(s) =>
    int tot = int(math.max(0.0, s))
    int m   = int(tot / 60)
    int sec = tot - m * 60
    str.tostring(m) + ":" + (sec < 10 ? "0" : "") + str.tostring(sec)
secsTxt(s) => s < 60 ? fmt0(math.ceil(s)) + " s" : fmtClock(s)
pctTxt(p) => na(p) ? "—" : (p > 0.99 or p < 0.01 ? str.tostring(p * 100, "#.00") : str.tostring(p * 100, "#.#")) + "%"
sgnTxt(x) => x >= 0 ? "+" : "−"
usd(x) => na(x) ? "—" : sgnTxt(x) + "$" + fmt0(math.abs(x))
fPhi(x) =>
    t = 1.0 / (1.0 + 0.2316419 * math.abs(x))
    d = 0.3989422804014327 * math.exp(-x * x / 2.0)
    p = d * t * (0.319381530 + t * (-0.356563782 + t * (1.781477937 + t * (-1.821255978 + t * 1.330274429))))
    x >= 0 ? 1.0 - p : p
fee(px) => feeCoef * px * (1.0 - px)
tblPos(s) =>
    s == "Top right" ? position.top_right : s == "Top left" ? position.top_left :
         s == "Middle right" ? position.middle_right : s == "Middle left" ? position.middle_left :
         s == "Bottom right" ? position.bottom_right : position.bottom_left
hudTxt = hudSize == "tiny" ? size.tiny : hudSize == "small" ? size.small : hudSize == "large" ? size.large : size.normal
// greedy word wrap so no HUD row is wider than a phone screen
wrap(s, w) =>
    words = str.split(s, " ")
    string out = ""
    string ln = ""
    if array.size(words) > 0
        for i = 0 to array.size(words) - 1
            wd = array.get(words, i)
            if str.length(ln) == 0
                ln := wd
            else if str.length(ln) + 1 + str.length(wd) <= w
                ln := ln + " " + wd
            else
                out := out + (str.length(out) > 0 ? "\n" : "") + ln
                ln := wd
    out + (str.length(out) > 0 ? "\n" : "") + ln

// ─────────────────────── Round clock (quarter hours, UTC) ───────────────────────
roundMs    = 900000
roundStart = math.floor(time / 900000.0) * roundMs
roundEnd   = roundStart + roundMs
isNewRound = ta.change(roundStart) != 0
barMs      = timeframe.in_seconds() * 1000
nowMs      = barstate.isrealtime ? timenow : time + barMs
secsLeft   = math.max(0.0, (roundEnd - nowMs) / 1000.0)
secsElapsed = 900.0 - secsLeft
minsElapsed = secsElapsed / 60.0
secIntoBar  = barstate.isrealtime ? math.max(0.0, math.min(60.0, (timenow - time) / 1000.0)) : 60.0
is1m = timeframe.isminutes and timeframe.multiplier == 1

// ─────────────────────── Live tick buffer (realtime only) ───────────────────────
varip array<int>   tkT = array.new<int>()
varip array<float> tkP = array.new<float>()
if barstate.isrealtime
    array.push(tkT, timenow)
    array.push(tkP, close)
    while array.size(tkT) > 0 and timenow - array.get(tkT, 0) > 150000
        array.shift(tkT)
        array.shift(tkP)
// time-weighted average of the ticks inside [fromMs, toMs]; returns [avg, coverage 0..1]
tickAvg(fromMs, toMs) =>
    n = array.size(tkT)
    float acc = 0.0
    float dur = 0.0
    if n > 0 and toMs > fromMs
        for i = 0 to n - 1
            t1 = array.get(tkT, i)
            t2 = i < n - 1 ? array.get(tkT, i + 1) : timenow
            a = math.max(t1, fromMs)
            b = math.min(t2, toMs)
            if b > a
                acc += array.get(tkP, i) * (b - a)
                dur += (b - a)
    [dur > 0 ? acc / dur : float(na), toMs > fromMs ? dur / (toMs - fromMs) : 0.0]
// the price `secs` seconds ago from the ticks (na on history or when the buffer is too short)
pxAgo(secs) =>
    float out = na
    n = array.size(tkT)
    if n > 0 and barstate.isrealtime
        tCut = timenow - secs * 1000
        if array.get(tkT, 0) <= tCut
            for i = n - 1 to 0
                if array.get(tkT, i) <= tCut
                    out := array.get(tkP, i)
                    break
    out

// ─────────────────────── What the PM line reads now (chart dollars) ───────────────────────
barAvg = 0.5 * ohlc4 + 0.5 * hl2                        // bar stand-in for a minute's time-average (history, thin buffer)
[dAvg, dCov] = tickAvg(nowMs - (WIN + dispLag) * 1000, nowMs - dispLag * 1000)
pmBars = ((60.0 - secIntoBar) * barAvg[1] + secIntoBar * barAvg) / 60.0
pmRaw  = dCov >= 0.9 ? dAvg : pmBars

// ─────────────────────────────── Target ───────────────────────────────
var float tgtEst   = na          // chart estimate of the price-to-beat = last round's settlement-window average
var bool  tgtTicks = false       // true when that estimate came from live ticks (±$2) rather than bars (±$25)
var int   typedRound = na        // the round live when you last changed settings: typed inputs belong to it
var float offLearn = na          // basis offset learned from a typed target (PM − chart)
if isNewRound
    [a, c] = tickAvg(roundStart - WIN * 1000, roundStart)
    tgtTicks := c >= 0.9
    tgtEst   := tgtTicks ? a : barAvg[1]
if barstate.isrealtime and na(typedRound)
    typedRound := roundStart
fresh      = roundStart == typedRound                   // typed inputs are for this round
typedThis  = tgtTyped > 0 and fresh
typedStale = typedThis and not na(tgtEst) and math.abs(tgtTyped - tgtEst) > close * 0.0015   // >0.15% off: a stale number
typedNow   = typedThis and not typedStale
if typedNow and tgtTicks and not na(tgtEst)
    offLearn := math.max(-50.0, math.min(50.0, tgtTyped - tgtEst))
offset   = not na(offLearn) ? offLearn : tgtAdj         // PM dollars = chart dollars + offset
target   = typedNow ? tgtTyped : tgtEst + offset        // PM dollars
tgtChart = target - offset                              // the same level in chart dollars (where everything is drawn)
tgtErr   = typedNow ? 0.5 : tgtTicks ? 2.0 : 25.0       // how far the target could be off ($)
tgtSrc   = typedNow ? "typed" : tgtTicks ? "from ticks ±$2" : "from bars ±$25 — type it"
pmShown  = pmRaw + offset                               // PM dollars
mktUpN   = fresh ? mktUp : 0.0
mktDnN   = fresh ? mktDn : 0.0
posBidN  = fresh ? posBid : 0.0

// ─────────────────── Volatility, ATR, TWAP, "bad minute" ───────────────────
r1     = math.log(close / close[1])
up1    = r1 > 0 ? r1 : 0.0
dn1    = r1 < 0 ? r1 : 0.0
sigBar = ta.stdev(r1, volLen) * close                                   // $ per √bar
sigUpB = math.sqrt(ta.sma(up1 * up1, volLen)) * math.sqrt(2.0) * close
sigDnB = math.sqrt(ta.sma(dn1 * dn1, volLen)) * math.sqrt(2.0) * close
sigS   = math.max(nz(sigBar) / math.sqrt(60.0), 0.5)                   // $ per √s
atr    = ta.atr(atrLen)
atrAvg = ta.sma(atr, 100)
volDanger = atr > atrAvg * atrMult
range3 = ta.highest(high, 3) - ta.lowest(low, 3)
twap   = ta.sma(close, twapLen)
// a "bad minute" = the badPct percentile of one-minute adverse excursions (prev close → bar extreme) over the last 24 h, in $
dnX1  = nz((close[1] - low) / close[1])
upX1  = nz((high - close[1]) / close[1])
badDn = nz(ta.percentile_nearest_rank(dnX1, 1440, badPct), 3.0 * nz(sigDnB) / close) * close
badUp = nz(ta.percentile_nearest_rank(upX1, 1440, badPct), 3.0 * nz(sigUpB) / close) * close

// ─────────────────── Momentum post physics (view only, never odds) ───────────────────
rawVel = (close - close[velLen]) / velLen
vel    = ta.ema(rawVel, smoothLen)                 // $ per bar
accEma = ta.ema(ta.change(vel), smoothLen)
velS   = vel / 60.0                                // $ per second
proj(p, v, a, t) => p + v * t + 0.5 * a * t * t

// ─────────────────── Record pace: the most BTC has moved in 1…15 minutes (loaded history) ───────────────────
// Fractions of price so old history scales to today. 1-min bars give every horizon; 5-min and 15-min bars (hundreds of
// days) back up the 5 / 10 / 15-minute horizons. Up and down are tracked separately: BTC falls faster than it rises.
upRec(h) => ta.max(nz((ta.highest(high, h) - close[h]) / close[h]))
dnRec(h) => ta.max(nz((close[h] - ta.lowest(low, h)) / close[h]))
rUp1  = upRec(1)
rUp2  = upRec(2)
rUp3  = upRec(3)
rUp4  = upRec(4)
rUp5  = upRec(5)
rUp6  = upRec(6)
rUp7  = upRec(7)
rUp8  = upRec(8)
rUp9  = upRec(9)
rUp10 = upRec(10)
rUp11 = upRec(11)
rUp12 = upRec(12)
rUp13 = upRec(13)
rUp14 = upRec(14)
rUp15 = upRec(15)
rDn1  = dnRec(1)
rDn2  = dnRec(2)
rDn3  = dnRec(3)
rDn4  = dnRec(4)
rDn5  = dnRec(5)
rDn6  = dnRec(6)
rDn7  = dnRec(7)
rDn8  = dnRec(8)
rDn9  = dnRec(9)
rDn10 = dnRec(10)
rDn11 = dnRec(11)
rDn12 = dnRec(12)
rDn13 = dnRec(13)
rDn14 = dnRec(14)
rDn15 = dnRec(15)
[rUp5b, rUp10b, rUp15b, rDn5b, rDn10b, rDn15b, bars5] = request.security(syminfo.tickerid, "5",
     [ta.max(nz((high - close[1]) / close[1])),
      ta.max(nz((ta.highest(high, 2) - close[2]) / close[2])),
      ta.max(nz((ta.highest(high, 3) - close[3]) / close[3])),
      ta.max(nz((close[1] - low) / close[1])),
      ta.max(nz((close[2] - ta.lowest(low, 2)) / close[2])),
      ta.max(nz((close[3] - ta.lowest(low, 3)) / close[3])),
      bar_index])
[rUp15c, rDn15c, bars15] = request.security(syminfo.tickerid, "15",
     [ta.max(nz((high - close[1]) / close[1])), ta.max(nz((close[1] - low) / close[1])), bar_index])
// dollars reachable by minute 0…15 at record pace × margin (index = minutes), never shrinking with the horizon
recTable(up) =>
    f = up ? array.from(0.0, rUp1, rUp2, rUp3, rUp4, rUp5, rUp6, rUp7, rUp8, rUp9, rUp10, rUp11, rUp12, rUp13, rUp14, rUp15) : array.from(0.0, rDn1, rDn2, rDn3, rDn4, rDn5, rDn6, rDn7, rDn8, rDn9, rDn10, rDn11, rDn12, rDn13, rDn14, rDn15)
    array.set(f, 5,  math.max(array.get(f, 5),  up ? rUp5b  : rDn5b))
    array.set(f, 10, math.max(array.get(f, 10), up ? rUp10b : rDn10b))
    array.set(f, 15, math.max(array.get(f, 15), up ? rUp15b : rDn15b, up ? rUp15c : rDn15c))
    for h = 1 to 15
        array.set(f, h, math.max(array.get(f, h), array.get(f, h - 1)))
    for h = 0 to 15
        array.set(f, h, array.get(f, h) * close * recScale)
    f
// minutes needed to cover `dist` dollars at record pace (interpolated); na = more than 15 minutes, never seen
needMins(dist, rec) =>
    float t = na
    if dist <= 0
        t := 0.0
    else
        for h = 1 to 15
            a = array.get(rec, h - 1)
            b = array.get(rec, h)
            if b >= dist
                t := (h - 1) + (b > a ? (dist - a) / (b - a) : 0.0)
                break
    t
// the most BTC has moved in `mins` minutes at record pace; anything under a minute gets the whole 1-minute record
// (flash moves happen in seconds), so LOCKED stays honest
recAt(mins, rec) =>
    float out = 0.0
    if mins >= 15
        out := array.get(rec, 15)
    else if mins <= 1 and mins > 0
        out := array.get(rec, 1)
    else if mins > 0
        k = int(math.floor(mins))
        lo = array.get(rec, k)
        hi = array.get(rec, k + 1)
        out := lo + (hi - lo) * (mins - k)
    out

// ─────────────────── Settlement window [bell−60 s, bell]: known part, KILL price, cushions ───────────────────
wStartMs = roundEnd - WIN * 1000
rpAll = (roundEnd - nowMs) / 1000.0                   // seconds to the bell
rpWin = math.max(0.0, math.min(WIN, rpAll))           // seconds of the settlement window still ahead
[kA, kC] = tickAvg(wStartMs, nowMs)
knownAvg = rpWin < WIN ? (kC >= 0.8 ? kA : barAvg) : close   // chart $ average of the part already in the books
// KILL price: what BTC must AVERAGE for the rest of the window to land the settlement exactly on the target (chart $)
killPx = rpWin >= WIN ? tgtChart : rpWin > 0 ? (WIN * tgtChart - (WIN - rpWin) * knownAvg) / rpWin : float(na)
cushUp = close - killPx          // $ BTC must fall (and hold) to flip UP;  < 0 = UP is already projected to lose
cushDn = killPx - close          // $ BTC must climb (and hold) to flip DOWN
// settlement average: mean and sd (sig = $/√s); the known part is fixed, the future is Brownian, momentum credit optional
settle(spot, sig) =>
    float mean = na
    float sd = na
    if rpAll <= 0
        mean := offset + knownAvg
        sd := 0.0
    else if rpAll >= WIN
        driftH = math.min(math.max(rpAll - WIN / 2.0, 0.0), 45.0)
        mean := offset + spot + driftW * velS * driftH
        sd := sig * math.sqrt(rpAll - WIN + WIN / 3.0)
    else
        futMean = spot + driftW * velS * (rpAll / 2.0)
        mean := offset + ((WIN - rpAll) * knownAvg + rpAll * futMean) / WIN
        sd := sig * math.sqrt(rpAll * rpAll * rpAll / 3.0) / WIN
    [mean, sd]
[sMean, sSd] = settle(close, sigS)
sKnown = rpAll <= 0 ? 1.0 : rpAll >= WIN ? 0.0 : (WIN - rpAll) / WIN
gap  = sMean - target                       // settlement mean vs target, PM $ (+ = UP side)
zS   = sSd > 0 ? gap / sSd : (gap >= 0 ? 99.0 : -99.0)
pUp  = sSd > 0 ? fPhi(zS) : (gap >= 0 ? 1.0 : 0.0)
pDn  = 1.0 - pUp
lean = pUp >= 0.5 ? 1 : -1
favTxt = lean > 0 ? "UP" : "DOWN"
pFav = lean > 0 ? pUp : pDn
sigAdvB = lean > 0 ? sigDnB : sigUpB
sigAdvS = math.max(nz(sigAdvB) / math.sqrt(60.0), 0.5)
[sMeanA, sSdA] = settle(close, sigAdvS)
pSafe = sSdA > 0 ? fPhi(math.abs(sMeanA - target) / sSdA) : 1.0
dev  = close - tgtChart                     // spot vs target, chart $ (+ = above)
lead = math.abs(dev)
spotSide = dev >= 0 ? 1 : -1
needMove = tgtChart - close                 // $ the spot must move to reach the target (+ = up)

// ─────────────────── Lookahead: the PM line in lookS seconds if BTC holds; BTC's last 10 s / 30 s ───────────────────
lookEff = math.max(1.0, math.min(lookS, rpAll))                      // never past the bell
fwStart = nowMs - int((WIN + dispLag - lookEff) * 1000)              // start of the window the line will show then (already past)
[fA, fC] = tickAvg(fwStart, nowMs)
fKnownS = math.max(0.0, math.min(WIN, (nowMs - fwStart) / 1000.0))
fKnownA = fC >= 0.8 ? fA : barAvg
fFutS   = WIN - fKnownS
pmAhead   = (fKnownS * fKnownA + fFutS * close) / WIN                 // chart $
pmAheadSd = sigS * math.sqrt(fFutS * fFutS * fFutS / 3.0) / WIN
mv10 = close - pxAgo(10)
mv30 = close - pxAgo(30)

// ─────────────────── LOCKED, lock ETA, fastest flip, reach (last bar only) ───────────────────
slack = tgtErr + tgtSlack
var float recUpLeft = na        // biggest UP move seen for the time left ($, × margin)
var float recDnLeft = na
var bool  lockUp = false
var bool  lockDn = false
var float lockEtaUp = na        // seconds until UP locks if BTC holds here (0 = now, na = not before the bell at this cushion)
var float lockEtaDn = na
var float fastUp = na           // minutes a record-pace move needs to reach UP's kill line
var float fastDn = na
var float reachMins = na
var float reachOdds = na
var int   reachTier = 0
var string reachWord = "—"
// seconds until a cushion beats the record for the time left: the cushion grows as cushion·rpWin/rp′ while the record shrinks
lockEta(cush, recTab) =>
    float eta = na
    if secsLeft > 1 and cush > 0
        for s = 1 to int(math.min(secsLeft, 600))
            sl  = secsLeft - s
            rp2 = math.max(0.0, math.min(WIN, sl))
            c2  = rp2 >= WIN ? cush : rp2 > 0 ? cush * rpWin / rp2 : 1.0e9
            if c2 > recAt(sl / 60.0, recTab) + slack
                eta := s
                break
    eta
if barstate.islast and not na(target) and secsLeft > 0
    upTab = recTable(true)
    dnTab = recTable(false)
    mLeft = secsLeft / 60.0
    recUpLeft := recAt(mLeft, upTab)
    recDnLeft := recAt(mLeft, dnTab)
    lockUp := cushUp > recDnLeft + slack              // UP survives even a record DROP held for the rest of the window
    lockDn := cushDn > recUpLeft + slack
    lockEtaUp := lockUp ? 0.0 : lockEta(cushUp, dnTab)
    lockEtaDn := lockDn ? 0.0 : lockEta(cushDn, upTab)
    fastUp := needMins(cushUp, dnTab)
    fastDn := needMins(cushDn, upTab)
    // the momentum post: minutes to the target at record pace in the needed direction, and the touch odds
    rmUp = needMins(math.abs(needMove), upTab)
    rmDn = needMins(math.abs(needMove), dnTab)
    reachMins := needMove >= 0 ? rmUp : rmDn
    recTow  = needMove >= 0 ? recUpLeft : recDnLeft
    sigTowS = math.max((needMove >= 0 ? nz(sigUpB) : nz(sigDnB)) / math.sqrt(60.0), 0.5)
    zT = math.abs(needMove) / (sigTowS * math.sqrt(secsLeft))
    reachOdds := math.min(1.0, 2.0 * (1.0 - fPhi(zT)))
    reachTier := math.abs(needMove) > recTow ? 0 : reachOdds < reachYellow / 100.0 ? 1 : reachOdds < reachGreen / 100.0 ? 2 : 3
    reachWord := reachTier == 0 ? "NOT POSSIBLE" : reachTier == 1 ? "UNLIKELY" : reachTier == 2 ? "EASILY" : "MOST LIKELY"
reachCol = reachTier == 0 ? colBad : reachTier == 1 ? colWarn : reachTier == 2 ? colEasy : colOk
reachMinsTxt = na(reachMins) ? "> 15 min" : reachMins < 0.1 ? "< 0.1 min" : fmt1(reachMins) + " min"

// ─────────────────── Average speed this round: dollars traversed per minute (tech row) ───────────────────
var float pathClosed   = 0.0
var float prevRoundAvg = na
if isNewRound
    prevRoundAvg := pathClosed / 15.0
    pathClosed := 0.0
barMove   = math.abs(close - nz(close[1], close))
pathRound = pathClosed + barMove
pathClosed += barMove
avgSpeed  = minsElapsed >= 1 ? pathRound / minsElapsed : prevRoundAvg
avgMins   = not na(avgSpeed) and avgSpeed > 0 ? math.abs(needMove) / avgSpeed : float(na)
avgMinsTxt = na(avgMins) ? "—" : avgMins > 99 ? "99+ min" : avgMins < 0.1 ? "< 0.1 min" : fmt1(avgMins) + " min"
avgTxt    = na(avgSpeed) ? "avg speed: no data yet" : avgMinsTxt + " at avg speed ($" + fmt0(avgSpeed) + "/min this round)"

// ─────────────────────── Market price vs fair · Alpha lights · EF window ───────────────────────
mktFav  = lean > 0 ? mktUpN : mktDnN
favAsk  = mktFav > 0 ? mktFav / 100.0 : float(na)
hasAsk  = not na(favAsk)
twapC   = twap[1]
slopeT  = twapC - twap[4]
slopeP  = close[1] - close[4]
cleanRun = (slopeT > 0 and slopeP > 0 and close[1] > twapC) or (slopeT < 0 and slopeP < 0 and close[1] < twapC)
revRisk  = (slopeT > 0 and close[1] < twapC) or (slopeT < 0 and close[1] > twapC)
l1 = lead >= buffer
l2 = lean > 0 ? twap > tgtChart + buffer : twap < tgtChart - buffer
l3 = cleanRun
l4 = not volDanger and range3 < lead
l5 = pSafe >= safeP
sidePx = hasAsk ? favAsk : pFav
l6 = sidePx <= maxAskA
conv = (l1 ? 1 : 0) + (l2 ? 1 : 0) + (l3 ? 1 : 0) + (l4 ? 1 : 0) + (l5 ? 1 : 0) + (l6 ? 1 : 0)
inWindow = minsElapsed >= entryFrom and minsElapsed < entryTo
lateKill = secsLeft <= killSecs
inChop   = lead < chopBand
efCheck  = useEF and ((secsElapsed >= 110 and secsElapsed <= 150) or (secsElapsed >= 170 and secsElapsed <= 210))
efOk     = efCheck and hasAsk and favAsk * 100 >= efLo and favAsk * 100 <= efHi

// ─────────────────────── Position: cushion, lock, hold/sell triggers ───────────────────────
sideName(s) => s > 0 ? "UP" : "DOWN"
posSet  = posSide != "None"
posDir  = fresh and posSide == "Up" ? 1 : fresh and posSide == "Down" ? -1 : 0
pMine   = posDir > 0 ? pUp : posDir < 0 ? pDn : float(na)
posShares = posDir != 0 ? posUsd / (posEntry / 100.0) : 0.0
posVal  = posDir != 0 ? posShares * pMine : float(na)
posCush = posDir > 0 ? cushUp : posDir < 0 ? cushDn : float(na)
posLock = posDir > 0 ? lockUp : posDir < 0 ? lockDn : false
posEta  = posDir > 0 ? lockEtaUp : posDir < 0 ? lockEtaDn : float(na)
posFast = posDir > 0 ? fastUp : posDir < 0 ? fastDn : float(na)
posRec  = posDir > 0 ? recDnLeft : posDir < 0 ? recUpLeft : float(na)   // the record move AGAINST you for the time left
posBad  = posDir > 0 ? badDn : badUp                                     // a 1-in-100-minutes move against you
towardKill = posDir > 0 ? nz(mv10) < 0 : nz(mv10) > 0
pace10  = math.abs(nz(mv10)) / 10.0                                     // $/s over the last 10 s
etaKill = posDir != 0 and towardKill and pace10 > 0.05 and posCush > 0 ? posCush / pace10 : float(na)
bidNet  = posBidN > 0 ? posBidN / 100.0 - fee(posBidN / 100.0) : float(na)
sellVal = posDir != 0 and not na(bidNet) ? posShares * bidNet : float(na)
marketPaysMore = posDir != 0 and not na(bidNet) and bidNet > pMine + 0.02
sellNow = posDir != 0 and not posLock and (posCush <= 0 or pMine < 0.5)
thin    = posDir != 0 and secsLeft <= 120 and posCush < posBad
getOut  = posDir != 0 and not posLock and not sellNow and (pMine < holdMinP / 100.0 or (not na(etaKill) and etaKill <= etaWarnS) or thin or marketPaysMore)

// ─────────────────────── Favorite: sure thing, flip risk, buy-in math ───────────────────────
sureThing = lean > 0 ? lockUp : lockDn
sureEta   = lean > 0 ? lockEtaUp : lockEtaDn
favCush   = lean > 0 ? cushUp : cushDn
favRec    = lean > 0 ? recDnLeft : recUpLeft
favBad    = lean > 0 ? badDn : badUp
favFlip   = 1.0 - pFav                                   // the real flip: the settlement lands on the other side
favScare  = lean != spotSide ? 1.0 : reachOdds           // the button scare: the spot crosses the target before the bell
winHold = sureThing ? 1.0 : math.min(pFav, 0.995)
bePrice(q, e) =>
    float p = q - e
    p := q - e - fee(p)
    p := q - e - fee(p)
    math.max(0.0, p)
askNow  = hasAsk ? favAsk : float(na)
edgeNow = hasAsk ? winHold - askNow - fee(askNow) : float(na)
beP     = bePrice(winHold, 0.0)
goodP   = bePrice(winHold, 0.04)
greatP  = bePrice(winHold, 0.08)
kellyF  = hasAsk and edgeNow > 0 and askNow < 1 ? edgeNow / (1.0 - askNow) : 0.0
scary   = favScare >= 0.25
buyGrade = na(edgeNow) ? "" : edgeNow >= 0.08 ? "GREAT" : edgeNow >= 0.04 ? "GOOD" : edgeNow >= 0.01 ? "FAIR" : "POOR"
varip float bestEdge = na
varip float bestAsk  = na
varip float bestLeft = na
if isNewRound
    bestEdge := na
    bestAsk := na
    bestLeft := na
if barstate.islast and hasAsk and not na(edgeNow) and (na(bestEdge) or edgeNow > bestEdge)
    bestEdge := edgeNow
    bestAsk := askNow
    bestLeft := secsLeft

// ─────────────────────── Plain-English pieces ───────────────────────
chanceWord(p) => p >= 0.5 ? "likely" : p >= 0.25 ? "a real chance" : p >= 0.10 ? "possible" : p >= 0.03 ? "unlikely" : p >= 0.005 ? "rare" : "very rare"
chanceTxt(p) => na(p) ? "unknown" : (p < 0.005 ? "under 1%" : p > 0.995 ? "over 99%" : fmt0(p * 100) + "%") + " (" + chanceWord(p) + ")"
fastTxt(m) => na(m) ? "more than 15 min" : m <= 0 ? "right now" : m < 1 ? fmt0(math.ceil(m * 60)) + " s" : fmt1(m) + " min"
etaTxt(e) => na(e) ? "no lock before the bell at this cushion" : e <= 0 ? "locked now" : "locks in ~" + secsTxt(e) + " if BTC holds here"

// ─────────────────────── The command ───────────────────────
string cmd = "WAIT"
string why = ""
string timing = ""
color  cmdCol = color.new(color.gray, 60)
efWin = secsTxt(secsElapsed < 160 ? 150 - secsElapsed : 210 - secsElapsed)
posWord  = sideName(posDir)
dropWord = posDir > 0 ? "drop" : "climb"
favDrop  = lean > 0 ? "drop" : "climb"
if na(target)
    cmd := "WAITING FOR THE FIRST ROUND BOUNDARY"
    why := "The target is estimated from the minute before the open. Type it from the PM screen to start now."
else if secsLeft <= 0
    cmd := "ROUND OVER — SETTLING"
    why := "Next target = this round's settlement average. Reset Side, asks and bid for the new round."
else if posDir != 0
    if posLock
        cmd := "LOCKED — HOLD " + posWord
        why := "Nothing can flip it. BTC would have to " + dropWord + " $" + fmt0(posCush) + " and stay there; the biggest " + dropWord + " ever seen for " + secsTxt(secsLeft) + " is $" + fmt0(posRec) + " (margin included). Ignore the button — a low bid now is other people's panic, not information."
        timing := "Settles in " + fmtClock(secsLeft) + " · 100% — the only time that number appears"
        cmdCol := color.new(colOk, 15)
    else if sellNow
        cmd := "SELL " + posWord + " NOW"
        why := (posCush <= 0 ? "If BTC stays here the average lands on the other side (cushion " + usd(posCush) + ")." : "The math has your side at " + pctTxt(pMine) + ".") + " Take whatever bid is left."
        timing := "Settles in " + fmtClock(secsLeft)
        cmdCol := color.new(colBad, 10)
    else if getOut
        reason = pMine < holdMinP / 100.0 ? "Win chance " + pctTxt(pMine) + " is under your " + str.tostring(holdMinP) + "% floor." : (not na(etaKill) and etaKill <= etaWarnS) ? "BTC moved " + usd(mv10) + " in the last 10 s — at that pace it reaches the kill line in ~" + secsTxt(etaKill) + "." : thin ? "Cushion $" + fmt0(posCush) + " is thinner than a 1-in-100-minutes " + dropWord + " ($" + fmt0(posBad) + ")." : "The bid (" + fmt0(posBidN) + "¢) pays more than the math (" + pctTxt(pMine) + ")."
        cmd := "SELL " + posWord + " — FLIP BUILDING"
        why := reason + " Sell while the bid is still high." + (not na(sellVal) ? " Selling keeps ≈$" + fmt0(sellVal) + "; holding is worth ≈$" + fmt0(posVal) + " (model)." : "")
        timing := "Fastest flip at record pace " + fastTxt(posFast) + " · " + fmtClock(secsLeft) + " left"
        cmdCol := color.new(colBad, 25)
    else
        cmd := "HOLD " + posWord
        why := "To flip you BTC must " + dropWord + " $" + fmt0(posCush) + " and hold it. Chance before the bell " + chanceTxt(1.0 - pMine) + ". A bad minute (1-in-100) is $" + fmt0(posBad) + ", the record $" + fmt0(posRec) + ". Last 10 s: " + (na(mv10) ? "live only" : usd(mv10)) + "."
        timing := etaTxt(posEta) + " · " + fmtClock(secsLeft) + " left"
        cmdCol := color.new(colEasy, 25)
else if sureThing and secsLeft > 4 and (not hasAsk or favAsk <= maxLock / 100.0)
    payUp = hasAsk ? favAsk : maxLock / 100.0
    net   = 1.0 - payUp - fee(payUp)
    cmd := "SURE THING — BUY " + favTxt + (hasAsk ? " AT " + fmt0(favAsk * 100) + "¢" : " UP TO " + str.tostring(maxLock) + "¢")
    why := "Locked: even a record move in the next " + secsTxt(secsLeft) + " cannot bring the average back across the target. +" + str.tostring(net * 100, "#.#") + "¢/share after fee."
    timing := "You have " + fmtClock(math.max(0.0, secsLeft - 5)) + " to get filled · ride to the bell"
    cmdCol := color.new(colOk, 10)
else if sureThing and hasAsk
    cmd := favTxt + " IS A SURE THING BUT COSTS " + fmt0(favAsk * 100) + "¢"
    why := "Above your " + str.tostring(maxLock) + "¢ max. Net would be " + str.tostring((1.0 - favAsk - fee(favAsk)) * 100, "#.#") + "¢/share."
    timing := "Settles in " + fmtClock(secsLeft)
    cmdCol := color.new(colWarn, 40)
else if volDanger
    cmd := "STAND DOWN — BTC IS TOO WILD"
    why := "It is swinging " + fmt1(atr / atrAvg) + "× its usual range. Nothing is a sure thing in a spike."
    timing := "Round ends in " + fmtClock(secsLeft)
    cmdCol := color.new(color.maroon, 10)
else if lateKill
    cmd := "ROUND ENDING — NO NEW BUYS"
    why := favTxt + " for now, not locked: real flip chance " + chanceTxt(favFlip) + ". " + fmt0(sKnown * 100) + "% of the average is in the books."
    timing := "Bell in " + fmtClock(secsLeft) + " · " + etaTxt(sureEta)
    cmdCol := color.new(color.purple, 30)
else if efOk
    cmd := "EF RULE — BUY " + favTxt + " AT " + fmt0(favAsk * 100) + "¢ WITH CAUTION"
    why := "Your tested rule (Oct 6–22): favorite at " + str.tostring(efLo) + "–" + str.tostring(efHi) + "¢ at 13:00 / 12:00 left, hold to the end. Not a sure thing: real flip chance " + chanceTxt(favFlip) + ", button scare " + chanceTxt(favScare) + "."
    timing := "Check window closes in " + efWin
    cmdCol := color.new(colPM, 20)
else if efCheck
    cmd := "EF CHECK — " + favTxt + " FOR NOW: buy only at " + str.tostring(efLo) + "–" + str.tostring(efHi) + "¢"
    why := (hasAsk ? "Typed ask " + fmt0(favAsk * 100) + "¢ is outside the band. " : "Type the ask in settings, or read it off the button. ") + "Real flip chance " + chanceTxt(favFlip) + "."
    timing := "Check window closes in " + efWin
    cmdCol := color.new(colPM, 55)
else if pFav >= 0.97
    cmd := "GET READY — " + favTxt + " IS CLOSE TO LOCKED"
    why := "To flip it BTC must " + favDrop + " $" + fmt0(favCush) + " and hold; the record for the time left is $" + fmt0(favRec) + ". Real flip chance " + chanceTxt(favFlip) + ", button scare " + chanceTxt(favScare) + ". Buying now is a caution play."
    timing := etaTxt(sureEta) + " · " + fmtClock(secsLeft) + " left"
    cmdCol := color.new(colWarn, 35)
else if useAlpha and inWindow and not inChop and conv >= minConv
    cmd := "BUY " + favTxt + " WITH CAUTION — " + str.tostring(conv) + " OF 6 CHECKS PASS"
    why := "Not a sure thing. BTC is $" + fmt0(lead) + " " + (dev >= 0 ? "above" : "below") + " the target. Real flip chance " + chanceTxt(favFlip) + ", button scare " + chanceTxt(favScare) + "." + (hasAsk ? " Ask " + fmt0(favAsk * 100) + "¢." : "")
    timing := etaTxt(sureEta) + " · " + fmtClock(secsLeft) + " left"
    cmdCol := lean > 0 ? color.new(colOk, 45) : color.new(colBad, 45)
else if inChop
    cmd := "WAIT — BTC IS HUGGING THE TARGET"
    why := favTxt + " for now by $" + fmt0(lead) + ". A coin flip until the gap opens."
    timing := "Round ends in " + fmtClock(secsLeft)
    cmdCol := color.new(colWarn, 70)
else
    cmd := "WAIT — " + favTxt + " FOR NOW"
    why := "Real flip chance " + chanceTxt(favFlip) + ". " + (useAlpha and inWindow ? str.tostring(conv) + " of 6 checks pass. " : "Outside the entry window. ") + "The sure thing usually shows up inside the last 2 minutes."
    timing := etaTxt(sureEta) + " · " + fmtClock(secsLeft) + " left"
    cmdCol := color.new(color.gray, 70)

// ─────────────────────── Chart layers (all in chart dollars) ───────────────────────
plot(showPM ? pmRaw : na, "PM line (60-s avg, chart $)", color = colPM, linewidth = 2)
plot(showTwap ? twap : na, "TWAP", color = color.new(color.green, 40), linewidth = 1)
roundIdx = int(roundStart / roundMs)
slot = roundIdx % 4
hueCol = slot == 0 ? color.rgb(41, 121, 255) : slot == 1 ? color.rgb(171, 71, 188) : slot == 2 ? color.rgb(0, 172, 193) : color.rgb(255, 167, 38)
isCurRound = roundStart == math.floor(timenow / 900000.0) * roundMs
inSettleWin = secsLeft <= WIN and secsLeft > 0
bgcolor(shadeRounds ? color.new(hueCol, isCurRound ? 84 : 91) : na, title = "Round shading")
bgcolor(inSettleWin ? color.new(colPM, 80) : na, title = "Settlement window (last 60 s)")
var array<line> marks = array.new<line>()
if shadeRounds and isNewRound
    array.push(marks, line.new(roundStart, close, roundStart, close + syminfo.mintick, xloc = xloc.bar_time, extend = extend.both, color = color.new(hueCol, 30), style = line.style_dashed, width = 1))
    if array.size(marks) > 60
        line.delete(array.shift(marks))

var line  tgtLine  = na
var label tgtLbl   = na
var line  killLine = na
var label killLbl  = na
var line  aheadLn  = na
var label aheadDot = na
var line  postLine = na
var label postLbl  = na
var array<line> tick = array.new<line>()
if barstate.islast and not na(target)
    line.delete(tgtLine)
    label.delete(tgtLbl)
    line.delete(killLine)
    label.delete(killLbl)
    line.delete(aheadLn)
    label.delete(aheadDot)
    line.delete(postLine)
    label.delete(postLbl)
    for l in tick
        line.delete(l)
    array.clear(tick)
    killShown = showKill and not na(killPx) and rpWin < WIN and math.abs(killPx - close) < 3.0 * math.max(nz(recUpLeft), nz(recDnLeft)) + 100.0
    // target: dashed line, one short label hugging the last bar (PM dollars in the text, chart dollars on the chart)
    tgtLine := line.new(bar_index - 100, tgtChart, bar_index + 20, tgtChart, xloc = xloc.bar_index, extend = extend.both, color = colTgt, style = line.style_dashed, width = 2)
    tgtLbl  := label.new(bar_index + 1, tgtChart, "TARGET " + fmtP(target) + (typedNow ? "" : " est") + (rpWin >= WIN ? " · kill" : ""), xloc = xloc.bar_index, style = label.style_label_left, color = colTgt, textcolor = color.black, size = size.small)
    // kill line: where BTC must average for the rest of the window to flip the result — it runs away from spot as the window fills
    if killShown
        killLine := line.new(bar_index - 40, killPx, bar_index + 10, killPx, xloc = xloc.bar_index, color = colKill, style = line.style_solid, width = 2)
        killLbl  := label.new(bar_index + 1, killPx, "KILL " + fmtP(killPx + offset) + " · " + usd(killPx - close), xloc = xloc.bar_index, style = label.style_label_left, color = colKill, textcolor = color.white, size = size.small)
    // lookahead stub: where the PM line will read in lookS seconds if BTC holds (dotted) and a dot at that reading
    if showAhead
        aheadLn  := line.new(bar_index, pmRaw, bar_index + 1, pmAhead, xloc = xloc.bar_index, color = colPM, style = line.style_dotted, width = 2)
        aheadDot := label.new(bar_index + 1, pmAhead, "", xloc = xloc.bar_index, style = label.style_circle, color = colPM, size = size.tiny)
    // momentum post: spot → target with minute ticks; one small label at the spot end, away from the target label
    if showPost
        xp = bar_index + 3
        postLine := line.new(xp, close, xp, tgtChart, xloc = xloc.bar_index, color = colPost, width = 3)
        dirP = tgtChart >= close ? 1 : -1
        float run = close
        maxM = int(math.max(1.0, math.min(15.0, math.ceil(secsLeft / 60.0))))
        for m = 1 to maxM
            p = proj(close, vel, accEma, m)
            if (p - run) * dirP <= 0
                break
            run := p
            if (p - tgtChart) * dirP > 0
                break
            array.push(tick, line.new(xp - 1, p, xp + 1, p, xloc = xloc.bar_index, color = color.new(colPost, 20), width = 2))
        postLbl := label.new(xp, close, reachMinsTxt + " at record pace\n" + reachWord + " · " + fmtClock(secsLeft) + " left", xloc = xloc.bar_index, style = dirP < 0 ? label.style_label_down : label.style_label_up, color = color.new(reachCol, 0), textcolor = reachTier >= 2 ? color.black : color.white, size = size.small)

// ─────────────────────── HUD ───────────────────────
var table hud = table.new(tblPos(hudPos), 1, 10, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.new(color.gray, 70))
row(r, txt, c, bg) =>
    table.cell(hud, 0, r, wrap(txt, hudW), text_color = c, text_size = hudTxt, text_halign = text.align_left, bgcolor = bg)
if barstate.islast
    blackBg = color.new(color.black, 100)
    sideX = posDir != 0 ? posDir : lean
    cushX = posDir != 0 ? posCush : favCush
    recX  = posDir != 0 ? posRec : favRec
    badX  = posDir != 0 ? posBad : favBad
    etaX  = posDir != 0 ? posEta : sureEta
    lockX = posDir != 0 ? posLock : sureThing
    moveW = sideX > 0 ? "drop" : "climb"
    aheadTxt = "NEXT " + fmt0(lookEff) + " S  PM line → " + fmtP(pmAhead + offset) + " (" + usd(pmAhead - tgtChart) + " vs target, ±$" + fmt0(pmAheadSd) + ")" + (lookEff < lookS ? " — that is the bell" : "") + " · BTC last 10 s " + (na(mv10) ? "—" : usd(mv10)) + " · 30 s " + (na(mv30) ? "— (live only)" : usd(mv30))
    killTxt = na(killPx) ? "KILL  —" : cushX <= 0 ? "KILL  " + sideName(sideX) + " is already past the kill line by $" + fmt0(-cushX) + " — if BTC holds here it loses" : "KILL  to flip " + sideName(sideX) + " BTC must " + moveW + " $" + fmt0(cushX) + " to " + fmtP(killPx + offset) + " and hold it · bad minute $" + fmt0(badX) + " · record $" + fmt0(recX) + " · " + etaTxt(etaX)
    oddsTxt = "ODDS  hold to bell UP " + pctTxt(pUp) + " · DOWN " + pctTxt(pDn) + (secsLeft < WIN ? " · " + fmt0(sKnown * 100) + "% in the books" : "") + " · button scare " + chanceTxt(favScare) + " · PM line " + usd(pmShown - target) + " vs target · target " + fmtP(target) + " (" + tgtSrc + ")"
    buyTxt = "BUY-IN  " + (hasAsk ? favTxt + " at " + fmt0(askNow * 100) + "¢: " + buyGrade + (scary and buyGrade != "POOR" ? " BUT SCARY" : "") + " · +" + fmt0((1.0 - askNow - fee(askNow)) * 100) + "¢ if right, −" + fmt0(askNow * 100) + "¢ if wrong · edge " + sgnTxt(edgeNow) + fmt1(math.abs(edgeNow) * 100) + "¢ · ¼-Kelly " + fmt0(kellyF * 25) + "% · " : "type the ask to grade a buy · ") + "win if held " + (sureThing ? "100%" : fmt0(winHold * 100) + "%") + " · break-even " + fmt0(beP * 100) + "¢ · GOOD < " + fmt0(goodP * 100) + "¢ · GREAT < " + fmt0(greatP * 100) + "¢"
    posTxt = posDir != 0 ? "IN " + sideName(posDir) + " @" + fmt0(posEntry) + "¢ for $" + fmt0(posUsd) + " · worth ≈$" + fmt0(posVal) + " (" + usd(posVal - posUsd) + ") · pays $" + fmt0(posShares) + " if it holds" + (not na(sellVal) ? " · selling at " + fmt0(posBidN) + "¢ keeps ≈$" + fmt0(sellVal) : " · type the SELL bid to compare") : buyTxt
    posBg  = posDir != 0 ? (posLock ? color.new(colOk, 70) : sellNow or getOut ? color.new(colBad, 60) : blackBg) : blackBg
    posCol = posDir != 0 ? color.white : not hasAsk ? color.silver : buyGrade == "POOR" ? colBad : buyGrade == "FAIR" or scary ? colEasy : colOk
    row(0, cmd, color.white, cmdCol)
    row(1, timing, color.yellow, blackBg)
    row(2, why, color.white, blackBg)
    row(3, aheadTxt, colPM, blackBg)
    row(4, killTxt, lockX ? colOk : cushX <= 0 ? colBad : colEasy, blackBg)
    if not hudCompact
        row(5, oddsTxt, color.silver, blackBg)
        row(6, posTxt, posCol, posBg)
    warn = (is1m ? "" : "Not a 1-minute chart — the clock and the records assume 1-min bars. ") + (typedStale ? "Typed target " + fmtP(tgtTyped) + " is $" + fmt0(math.abs(tgtTyped - tgtEst)) + " from the estimate — ignored as stale; zero it or retype. " : "") + (not tgtTicks and not typedNow and not na(tgtEst) ? "Target is from bars (±$25): type it from the PM screen before trusting LOCKED. " : "") + (posSet and not fresh ? "Side is set from an earlier round — reset it or re-enter it. " : "") + (bar_index < 1440 ? "Under a day of 1-min history loaded — bad-minute and record levels are thin. " : "")
    row(7, str.length(warn) > 0 ? "⚠ " + warn : "", colWarn, blackBg)
    if showTech
        lights = (l1 ? "Lead ✓" : "Lead ✗") + " " + (l2 ? "Trend ✓" : "Trend ✗") + " " + (l3 ? "Momentum ✓" : "Momentum ✗") + " " + (l4 ? "Calm ✓" : "Calm ✗") + " " + (l5 ? "Safe ✓" : "Safe ✗") + " " + (l6 ? "Headroom ✓" : "Headroom ✗") + " (" + str.tostring(conv) + "/6)" + (useAlpha and inWindow ? "" : " · outside the Alpha window")
        techTxt = "TECH  safe on adverse vol " + pctTxt(pSafe) + " · settle avg " + usd(gap) + " vs target, 3σ $" + fmt1(sSd * 3) + " · 1σ/min $" + fmt0(nz(sigBar)) + " (adverse $" + fmt0(nz(sigAdvB)) + ") · ATR " + fmt1(atr / atrAvg) + "× · last 3 min range $" + fmt0(range3) + (volDanger ? " · WILD" : cleanRun ? " · clean trend" : revRisk ? " · turning" : "") + " · post " + reachWord + ": $" + fmt0(math.abs(needMove)) + " " + (needMove >= 0 ? "up" : "down") + " to target, " + reachMinsTxt + " at record pace, touch odds " + pctTxt(reachOdds) + " · " + avgTxt + " · history " + fmt0(bar_index / 1440.0) + "d 1-min, " + fmt0(bars5 / 288.0) + "d 5-min, " + fmt0(bars15 / 96.0) + "d 15-min" + (mktUpN > 0 ? " · UP mkt " + fmt0(mktUpN) + " vs fair " + fmt0(pUp * 100) : "") + (mktDnN > 0 ? " · DOWN mkt " + fmt0(mktDnN) + " vs fair " + fmt0(pDn * 100) : "") + (not na(bestEdge) ? " · best edge this round " + sgnTxt(bestEdge) + fmt1(math.abs(bestEdge) * 100) + "¢ at " + fmt0(bestAsk * 100) + "¢ with " + fmtClock(bestLeft) + " left" : "")
        row(8, lights, conv >= minConv ? colOk : color.silver, blackBg)
        row(9, techTxt, color.silver, blackBg)

// ─────────────────────── Alerts ───────────────────────
sureOn = sureThing and posDir == 0 and secsLeft > 4 and (not hasAsk or favAsk <= maxLock / 100.0)
lockOn = posDir != 0 and posLock
alertcondition(sureOn and not sureOn[1], "SURE THING for sale", "PM15 Brain: SURE THING — locked; buy the favorite and ride to the bell")
alertcondition(lockOn and not lockOn[1], "Position LOCKED", "PM15 Brain: LOCKED — nothing can flip your side; hold to the bell, ignore the button")
alertcondition(efOk and not efOk[1], "EF rule fires", "PM15 Brain: Early Favorite rule — buy the favorite with caution and hold")
alertcondition(sellNow and not sellNow[1], "SELL NOW", "PM15 Brain: SELL NOW — the settlement is projected against you")
alertcondition(getOut and not getOut[1], "SELL — flip building", "PM15 Brain: SELL — the flip is building, take the bid while it is high")
if sureOn and not sureOn[1]
    alert("PM15 Brain: SURE THING — buy " + favTxt + (hasAsk ? " at " + fmt0(favAsk * 100) + "¢" : "") + ", " + fmtClock(secsLeft) + " left", alert.freq_once_per_bar)
if lockOn and not lockOn[1]
    alert("PM15 Brain: LOCKED — " + sideName(posDir) + " cannot be flipped, " + fmtClock(secsLeft) + " left; hold, ignore the button", alert.freq_once_per_bar)
if sellNow and not sellNow[1]
    alert("PM15 Brain: SELL " + sideName(posDir) + " NOW — settlement projected against you, " + fmtClock(secsLeft) + " left", alert.freq_once_per_bar)
if getOut and not getOut[1]
    alert("PM15 Brain: SELL " + sideName(posDir) + " — flip building (cushion $" + fmt0(posCush) + "), " + fmtClock(secsLeft) + " left", alert.freq_once_per_bar)
