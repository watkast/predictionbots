//@version=6
// =============================================================================
//  VELOCITY REACH vs TARGET  (v5.3)
//  ---------------------------------------------------------------------------
//  • Velocity      = smoothed price change per bar (signed)
//  • Acceleration  = change in velocity per bar
//  • Projection    = p(t) = p0 + v·t + ½·a·t²   (t in bars, kinematics)
//  • Target        = by default the Polymarket US 15-min round's price-to-beat,
//                    estimated from the chart the same way as the EF Signal HUD:
//                    rounds start on the quarter hour (UTC); the price-to-beat is
//                    the average of the 60 BRTI prints in the minute before the
//                    start ≈ midpoint of that 1-min bar (~$2.70 off on average).
//                    "Round target offset" nudges it to Polymarket's exact number.
//                    A manual price or the recent swing high can be used instead.
//  • Direction     = the post always runs from the current price TOWARD the
//                    target: UP when price is below it (can it cross up in
//                    time?), DOWN when price is above it (can it fall back below
//                    in time?). If you hold the side that is currently winning,
//                    a possible cross is the threat.
//  • Reach         = furthest point the projection gets toward the target
//                    inside the horizon
//  • Reach line    = thick vertical post just right of the last candle:
//                    current price → projected reach, against the dashed
//                    target line.
//        GREEN  = reach crosses the target in time
//        YELLOW = crosses it, but only after the time left (NOT IN TIME)
//        RED    = never gets there at the current velocity
//  • Ruler         = tick marks on the post showing where the path sits after
//                    1, 2, 3… bars, labelled in chart time (1m, 2m… / 1h, 2h…).
//                    Major tick every 5 bars. Ticks stop at the peak / trough.
//                    Past the time left the post continues dashed (dimmed
//                    ticks) to the target + N extra bars, and the tick where
//                    the target is hit is marked "◀ TARGET".
//  • ETA line      = thin dashed vertical line at the bar where the projected
//                    path meets the target
//  • Horizon       = by default the time left in the current round: the status
//                    reads "UP-CROSS POSSIBLE in less than 3:42" (the time left)
//                    and the alerts carry the same wording.
//  • Position row  = assumes you hold the side that needs the cross (no inputs).
//                    Cross possible in time → BUY +x% more, x = spare time
//                    (1 − ETA / time left). Otherwise → SELL x%, x = the share
//                    of the distance the projection does NOT cover in time
//                    (moving away = SELL 100%). Information only: the EF rule
//                    tested Oct 6-22 was buy once and hold to the end.
//  • Win prob      = EF HUD formula (price lead vs volatility over the time
//                    left, k = 0.94) with optional momentum drift.
//  • Rounds        = each 15-min round gets its own background tint (four
//                    rotating colors, or two alternating shades), the live
//                    round slightly stronger, and a dashed vertical mark at
//                    every quarter-hour boundary.
//  Built for a 1-min chart. Info table + alerts included.
// =============================================================================
indicator("Velocity Reach vs Target", shorttitle = "Velocity Reach", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_polylines_count = 5)

// ─────────────────────────────── Inputs ───────────────────────────────
gT = "Target"
tgtSource    = input.string("Polymarket round (price to beat)", "Target source",
     options = ["Polymarket round (price to beat)", "Manual price", "Recent swing high"], group = gT, display = display.none)
targetInput  = input.float(0.0, "Manual target price  (0 = fall back to swing high)", minval = 0, step = 100, group = gT, display = display.none)
tgtAdj       = input.float(0.0, "Round target offset ($) = Polymarket price-to-beat minus chart estimate", step = 0.5, group = gT)
autoLookback = input.int(50, "Swing-high lookback (bars)", minval = 2, group = gT, display = display.none)

gV = "Velocity / Acceleration"
velLen    = input.int(14, "Velocity lookback (bars)", minval = 1, group = gV,
     tooltip = "Velocity = average price change per bar over this window")
smoothLen = input.int(5, "Smoothing (EMA length)", minval = 1, group = gV)
useAccel  = input.bool(true, "Include acceleration / deceleration", group = gV,
     tooltip = "ON: p = v·t + ½·a·t²    OFF: straight line p = v·t")

gP = "Projection"
horizonMode = input.string("Time left in round", "Horizon", options = ["Time left in round", "Fixed bars"], group = gP,
     tooltip = "Time left in round: GREEN = the path crosses the target before the current 15-min round ends", display = display.none)
horizon    = input.int(20, "Fixed horizon (bars ahead)", minval = 1, maxval = 300, group = gP, display = display.none)
lineOffset = input.int(2, "Reach line offset (bars right of last bar)", minval = 0, maxval = 50, group = gP, display = display.none)
showPath   = input.bool(true, "Draw projected path", group = gP)
showEta    = input.bool(true, "Draw ETA line at projected cross", group = gP)
showRuler  = input.bool(true, "Ruler ticks on reach line (one per bar)", group = gP)
labelEvery = input.int(1, "Ruler: label every N ticks", minval = 1, group = gP, display = display.none)
rulerSize  = input.string("small", "Ruler: label size", options = ["tiny", "small", "normal"], group = gP, display = display.none)
extendPast = input.int(5, "Ruler: extend past horizon to target (+N bars beyond, 0 = off)", minval = 0, maxval = 200, group = gP, display = display.none)

gH = "HUD"
showTable = input.bool(true, "Show info table", group = gH)
tablePos  = input.string("Middle right", "Table position",
     options = ["Middle right", "Middle left", "Top right", "Top left", "Bottom right", "Bottom left"], group = gH, display = display.none)
hudSize   = input.string("small", "Table text size", options = ["tiny", "small", "normal"], group = gH, display = display.none)

gS = "Win probability"
driftW    = input.float(0.5, "Momentum drift weight (0 = pure EF HUD estimate, 1 = full projection)",
     minval = 0, maxval = 1, step = 0.1, group = gS, display = display.none)

gB = "Round shading (15-min marks)"
bgMode     = input.string("Four colors", "Background", options = ["Four colors", "Two shades", "Off"], group = gB, display = display.none)
bgTransp   = input.int(88, "Background transparency (higher = fainter)", minval = 50, maxval = 100, group = gB, display = display.none)
liveBoost  = input.int(8, "Current round: extra opacity", minval = 0, maxval = 30, group = gB, display = display.none)
showMarks  = input.bool(true, "Vertical line at each 15-min mark", group = gB)
markWidth  = input.int(1, "Mark line width", minval = 1, maxval = 3, group = gB, display = display.none)
keepMarks  = input.int(60, "Keep marks for the last N rounds", minval = 4, maxval = 400, group = gB, display = display.none)

gC = "Colors"
colOk     = input.color(color.lime,   "Cross possible",  group = gC)
colBeyond = input.color(color.yellow, "Not in time",     group = gC)
colNo     = input.color(color.red,    "Not possible",    group = gC)
colTgt    = input.color(color.orange, "Target line",     group = gC)
colPath   = input.color(color.aqua,   "Projected path",  group = gC)

// ─────────────────────────────── Helpers ───────────────────────────────
fmtP(x) => str.tostring(x, format.mintick)
fmt2(x) => str.tostring(x, "#.##")
fmt0(x) => str.tostring(x, "#")
fmtClock(s) =>
    int tot = int(math.max(0.0, s))
    int m   = int(tot / 60)
    int sec = tot - m * 60
    str.tostring(m) + ":" + (sec < 10 ? "0" : "") + str.tostring(sec)

// bars → chart-time label: "3m", "2.5h", "1d" …
durTxt(bars) =>
    secs = bars * timeframe.in_seconds()
    secs < 60 ? str.tostring(secs) + "s" :
         secs < 3600 ? str.tostring(secs / 60.0, "#") + "m" :
         secs < 86400 ? str.tostring(secs / 3600.0, "#.#") + "h" :
         str.tostring(secs / 86400.0, "#.#") + "d"

// Standard normal CDF (same approximation as the EF Signal HUD)
fPhi(x) =>
    t = 1.0 / (1.0 + 0.3275911 * math.abs(x))
    y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * math.exp(-x * x / 2.0)
    x >= 0 ? 0.5 + 0.5 * y : 0.5 - 0.5 * y

tblPos(s) =>
    s == "Top right" ? position.top_right : s == "Top left" ? position.top_left :
         s == "Middle right" ? position.middle_right : s == "Middle left" ? position.middle_left :
         s == "Bottom right" ? position.bottom_right : position.bottom_left

rulerTextSize = rulerSize == "tiny" ? size.tiny : rulerSize == "normal" ? size.normal : size.small
hudTextSize   = hudSize   == "tiny" ? size.tiny : hudSize   == "normal" ? size.normal : size.small

// ─────────────────── Velocity & acceleration (price per bar) ───────────────────
rawVel = (close - close[velLen]) / velLen
vel    = ta.ema(rawVel, smoothLen)                 // signed velocity   (price / bar)
accEma = ta.ema(ta.change(vel), smoothLen)
acc    = useAccel ? accEma : 0.0                   // acceleration      (price / bar²)

// ─────────── Polymarket round clock (rounds start on the quarter hour, UTC) ───────────
roundMs    = 900000
roundStart = math.floor(time / 900000.0) * roundMs
isNewRound = ta.change(roundStart) != 0
barMs      = timeframe.in_seconds() * 1000
nowMs      = barstate.isrealtime ? timenow : time + barMs
secsLeft   = math.max(0.0, (roundStart + roundMs - nowMs) / 1000.0)
barsLeft   = math.max(1, math.ceil(secsLeft / timeframe.in_seconds()))
oneMin     = timeframe.isminutes and timeframe.multiplier == 1

// Price-to-beat estimate (same stand-in as the EF Signal HUD): on a 1-min chart the midpoint of the
// bar before the round starts; on other timeframes the first print of the round.
var float roundAnchor = na
if isNewRound
    roundAnchor := oneMin ? (high[1] + low[1]) / 2 : open
roundTarget = roundAnchor + tgtAdj

// ─────────── Round shading: alternating background per round + a mark at each 15-min boundary ───────────
roundIdx   = int(roundStart / roundMs)                  // round counter (since epoch)
slot       = roundIdx % 4
hueCol     = slot == 0 ? color.rgb(41, 121, 255) :      // blue
     slot == 1 ? color.rgb(171, 71, 188) :              // purple
     slot == 2 ? color.rgb(0, 172, 193) :               // teal
     color.rgb(255, 167, 38)                            // amber
shadeCol   = roundIdx % 2 == 0 ? color.rgb(120, 144, 156) : color.rgb(38, 50, 56)
roundCol   = bgMode == "Four colors" ? hueCol : shadeCol
isCurRound = roundStart == math.floor(timenow / 900000.0) * roundMs
bgT        = math.max(0, bgTransp - (isCurRound ? liveBoost : 0))
bgcolor(bgMode == "Off" ? na : color.new(roundCol, bgT), title = "Round shading")

var array<line> roundMarks = array.new<line>()
if showMarks and isNewRound
    array.push(roundMarks, line.new(roundStart, close, roundStart, close + syminfo.mintick, xloc = xloc.bar_time,
         extend = extend.both, color = color.new(roundCol, 30), style = line.style_dashed, width = markWidth))
    if array.size(roundMarks) > keepMarks
        line.delete(array.shift(roundMarks))

// ─────────────────────────────── Target ───────────────────────────────
swingHigh = ta.highest(high, autoLookback)
target    = tgtSource == "Polymarket round (price to beat)" ? roundTarget :
     tgtSource == "Manual price" and targetInput > 0 ? targetInput : swingHigh
tgtName   = tgtSource == "Polymarket round (price to beat)" ? "Price to beat (est.)" :
     tgtSource == "Manual price" and targetInput > 0 ? "Target (manual)" : "Target (swing high)"

// ─────────────────── Projection  p(t) = p0 + v·t + ½·a·t² ───────────────────
proj(p, v, a, t) => p + v * t + 0.5 * a * t * t

p0 = close
roundMode = horizonMode == "Time left in round"
Nf = roundMode ? math.max(secsLeft / timeframe.in_seconds(), 0.01) : float(horizon)   // horizon in bars (fractional in round mode)
N  = math.max(1, math.ceil(Nf))                                                        // whole bars, for drawing
withinTxt = roundMode ? fmtClock(secsLeft) : durTxt(horizon)                            // "3:42" (time left) or "20m"

// Direction of the question: +1 = target above price (up-cross), -1 = target below price (down-cross)
dist = target - p0
dir  = dist >= 0 ? 1 : -1
atTarget = math.abs(dist) < syminfo.mintick / 2

// Furthest point the projected path gets toward the target inside the horizon
reachRaw = proj(p0, vel, acc, Nf)
reach    = dir > 0 ? math.max(p0, reachRaw) : math.min(p0, reachRaw)
if math.abs(acc) > 1e-10
    tPeak = -vel / acc                              // bar where velocity hits zero
    if tPeak > 0 and tPeak < Nf
        pk = proj(p0, vel, acc, tPeak)
        reach := dir > 0 ? math.max(reach, pk) : math.min(reach, pk)

// Bars until the path first touches the target  (na = never at this pace)
barsToTarget = float(na)
if atTarget
    barsToTarget := 0.0
else if math.abs(acc) < 1e-10
    if vel * dist > 0                               // moving toward the target
        barsToTarget := dist / vel
else
    disc = vel * vel + 2.0 * acc * dist
    if disc >= 0
        sq   = math.sqrt(disc)
        r1   = (-vel - sq) / acc
        r2   = (-vel + sq) / acc
        best = float(na)
        if r1 > 0
            best := r1
        if r2 > 0 and (na(best) or r2 < best)
            best := r2
        barsToTarget := best

possible    = not atTarget and not na(barsToTarget) and barsToTarget <= Nf    // crosses within the time left
beyond      = not atTarget and not na(barsToTarget) and barsToTarget >  Nf    // crosses, but too late
crossedUp   = ta.crossover(close, target)
crossedDown = ta.crossunder(close, target)

statusCol = atTarget or possible ? colOk : beyond ? colBeyond : colNo
barsTxt   = na(barsToTarget) ? "—" : str.tostring(math.ceil(barsToTarget))
etaTxt    = na(barsToTarget) ? "—" : durTxt(math.ceil(barsToTarget))
dirTxt    = dir > 0 ? "UP-CROSS" : "DOWN-CROSS"
statusTxt = atTarget ? "AT TARGET  (" + withinTxt + " left)" :
     possible ? dirTxt + " POSSIBLE ✔ in less than " + withinTxt + "  (ETA ~" + etaTxt + ")" :
     beyond   ? dirTxt + " NOT IN TIME ✘  ETA ~" + etaTxt + ", " + withinTxt + " left" :
     dirTxt + " NOT POSSIBLE ✘ in less than " + withinTxt
sideTxt   = atTarget ? "AT TARGET" : dist < 0 ? "ABOVE by $" + fmt2(-dist) + " · UP winning" : "BELOW by $" + fmt2(dist) + " · DOWN winning"

// ─────────── Win probability (EF Signal HUD formula + optional momentum drift) ───────────
kScale = 0.94
volLen = 60
r1    = math.log(close / close[1])
sigma = ta.stdev(r1, volLen) * close             // $ per sqrt(bar)
tau   = math.max(Nf, 0.25)
lead  = -dist                                     // + = UP winning
driftDisp = reachRaw - p0                         // projected move by the end of the horizon
pUp   = (na(target) or na(sigma) or sigma <= 0) ? float(na) : fPhi(kScale * (lead + driftW * driftDisp) / (sigma * math.sqrt(tau)))
pMine = dir > 0 ? pUp : 1.0 - pUp                 // my side = the side that needs the cross

// ─────────────────────────────── Drawing ───────────────────────────────
var line     reachLine  = na
var line     targetLine = na
var line     etaLine    = na
var line     extLine    = na
var polyline pathExt    = na
var label    reachLbl   = na
var label    tgtLbl     = na
var label    crossLbl   = na
var polyline path       = na
var array<line>  tickLines = array.new<line>()
var array<label> tickLbls  = array.new<label>()
// One narrow column so the HUD fits a phone screen (two columns pushed the labels off the left edge)
var table    info       = table.new(tblPos(tablePos), 1, 8, bgcolor = color.new(color.black, 15),
     border_width = 1, border_color = color.new(color.gray, 70))

hudRow(r, v, c) =>
    table.cell(info, 0, r, v, text_color = c, text_size = hudTextSize, text_halign = text.align_left)

if barstate.islast and not na(reach) and not na(target)
    line.delete(reachLine)
    line.delete(targetLine)
    line.delete(etaLine)
    line.delete(extLine)
    polyline.delete(pathExt)
    label.delete(reachLbl)
    label.delete(tgtLbl)
    label.delete(crossLbl)
    polyline.delete(path)
    for l in tickLines
        line.delete(l)
    array.clear(tickLines)
    for lb in tickLbls
        label.delete(lb)
    array.clear(tickLbls)

    x0       = bar_index
    xr       = bar_index + lineOffset
    reachPct = (reach / p0 - 1) * 100

    // How far the ruler / path run: to the horizon, or past it to the target + extra bars
    tEnd = N
    if extendPast > 0 and not na(barsToTarget) and barsToTarget > 0
        tEnd := math.min(math.max(N, math.ceil(barsToTarget) + extendPast), 300)

    // Vertical reach post: current price → projected reach (up or down, toward the target)
    reachLine := line.new(xr, p0, xr, reach, xloc = xloc.bar_index, color = statusCol, width = 4)
    reachLbl  := label.new(xr, reach, "Reach " + fmtP(reach) + "  (" + fmt2(reachPct) + "%)",
         xloc = xloc.bar_index, style = label.style_label_right, color = color.new(statusCol, 15),
         textcolor = color.black, size = size.small)

    // Ruler: tick + time label where the path sits after 1, 2, 3… bars
    // (only while the path keeps making progress toward the target; major tick every 5 bars).
    // Past the time left ticks are dimmed; the tick that reaches the target is marked.
    if showRuler
        runExt = p0
        prevY  = p0
        for t = 1 to tEnd
            y = proj(p0, vel, acc, t)
            newExt = dir > 0 ? y > runExt : y < runExt
            if newExt
                runExt := y
                beyondH = t > Nf                      // past the time left → dimmed (matches the status)
                hitTgt  = dir > 0 ? (y >= target and prevY < target) : (y <= target and prevY > target)
                major   = t % 5 == 0
                tickCol = hitTgt ? colTgt : color.new(statusCol, beyondH ? 60 : (major ? 0 : 35))
                array.push(tickLines, line.new((major or hitTgt) ? xr - 1 : xr, y, xr + 1, y, xloc = xloc.bar_index,
                     color = tickCol, width = (major or hitTgt) ? 2 : 1))
                if t % labelEvery == 0 or hitTgt
                    txt = durTxt(t) + (hitTgt ? "  ◀ TARGET" : "")
                    array.push(tickLbls, label.new(xr + 1, y, txt, xloc = xloc.bar_index,
                         style = label.style_label_left, color = color.new(color.black, 100),
                         textcolor = hitTgt ? colTgt : color.new(chart.fg_color, beyondH ? 50 : 10),
                         size = rulerTextSize))
            prevY := y
        // Dashed continuation of the post beyond the horizon
        extNeeded = dir > 0 ? runExt > reach : runExt < reach
        if extNeeded
            extLine := line.new(xr, reach, xr, runExt, xloc = xloc.bar_index, color = color.new(statusCol, 50),
                 style = line.style_dashed, width = 2)

    // Horizontal target line
    targetLine := line.new(x0 - 1, target, x0 + N + lineOffset, target, xloc = xloc.bar_index,
         extend = extend.both, color = colTgt, style = line.style_dashed, width = 1)
    tgtLbl := label.new(x0 + N + lineOffset, target, tgtName + " " + fmtP(target),
         xloc = xloc.bar_index, style = label.style_label_left, color = color.new(colTgt, 15),
         textcolor = color.black, size = size.small)

    // Dotted projected path
    if showPath
        pts   = array.new<chart.point>()
        steps = math.min(N, 60)
        for i = 0 to steps
            t = float(N) * i / steps
            array.push(pts, chart.point.from_index(x0 + math.round(t), proj(p0, vel, acc, t)))
        path := polyline.new(pts, curved = false, closed = false, xloc = xloc.bar_index,
             line_color = colPath, line_style = line.style_dotted, line_width = 2)
        // Dimmed continuation of the path past the horizon
        if tEnd > N
            pts2   = array.new<chart.point>()
            span   = tEnd - N
            steps2 = math.min(span, 60)
            for j = 0 to steps2
                t2 = N + float(span) * j / steps2
                array.push(pts2, chart.point.from_index(x0 + math.round(t2), proj(p0, vel, acc, t2)))
            pathExt := polyline.new(pts2, curved = false, closed = false, xloc = xloc.bar_index,
                 line_color = color.new(colPath, 60), line_style = line.style_dotted, line_width = 1)

    // ETA line + marker where the path meets the target (green = in time, yellow = too late)
    if not na(barsToTarget) and barsToTarget > 0 and barsToTarget <= 480
        xc   = x0 + math.ceil(barsToTarget)
        cCol = possible ? colOk : colBeyond
        if showEta
            etaLine := line.new(xc, p0, xc, target, xloc = xloc.bar_index, color = color.new(cCol, 40),
                 style = line.style_dashed, width = 1)
        arrow    = dir > 0 ? "▲" : "▼"
        crossTxt = possible ? arrow + " cross in ~" + etaTxt + " ✔  (" + withinTxt + " left)" :
             arrow + " cross in ~" + etaTxt + " ✘  only " + withinTxt + " left"
        crossLbl := label.new(xc, target, crossTxt,
             xloc = xloc.bar_index, style = dir > 0 ? label.style_label_down : label.style_label_up,
             color = color.new(cCol, 15), textcolor = color.black, size = size.small)

    // Position row: you hold the side that needs the cross. Size from distance and time:
    //   cross in time → BUY +x% more, x = spare time (1 − ETA / time left)
    //   otherwise     → SELL x%, x = share of the distance the projection does not cover in time
    string posTxt = "AT TARGET → HOLD"
    color  posCol = color.white
    if not atTarget
        coverage = math.abs(reach - p0) / math.abs(dist)          // 0 = moving away … 1 = reaches the target in time
        if possible
            spare  = math.max(0.0, 1.0 - barsToTarget / Nf)
            addPct = spare * 100
            posTxt := "ETA ~" + etaTxt + " of " + withinTxt + (addPct >= 1 ? " → BUY +" + fmt0(addPct) + "% more" : " → HOLD")
            posCol := colOk
        else
            sellPct = math.min(100.0, (1.0 - coverage) * 100)
            posTxt := (coverage <= 0 ? "moving away" : "covers " + fmt0(coverage * 100) + "% of $" + fmt2(math.abs(dist))) +
                 " → SELL " + fmt0(sellPct) + "%"
            posCol := sellPct >= 50 ? colNo : colBeyond

    // Info table (one column, short lines)
    if showTable
        perHour  = vel * 3600.0 / timeframe.in_seconds()
        tgtShort = tgtSource == "Polymarket round (price to beat)" ? "Beat (est.)" : "Target"
        hudRow(0, "Round  " + fmtClock(secsLeft) + " left · " + str.tostring(barsLeft) + " bars",            color.white)
        hudRow(1, sideTxt,                                                                                  dist < 0 ? colOk : colNo)
        hudRow(2, "v " + fmt2(vel) + "/bar (" + fmt0(perHour) + "/hr) · a " + fmt2(acc) + "/bar²",            vel >= 0 ? colOk : colNo)
        hudRow(3, "Reach " + fmtP(reach) + " (" + fmt2(reachPct) + "%) in " + withinTxt,                    statusCol)
        hudRow(4, tgtShort + " " + fmtP(target) + " (" + fmt2(dist / p0 * 100) + "% away) · ETA " + etaTxt, colTgt)
        hudRow(5, statusTxt,                                                                                statusCol)
        hudRow(6, na(pUp) ? "p —" : "p UP " + fmt0(pUp * 100) + "% · DOWN " + fmt0((1.0 - pUp) * 100) + "% · cross " + fmt0(pMine * 100) + "%", color.white)
        hudRow(7, "Position: " + posTxt,                                                                    posCol)

// ─────────────────────────── Signals & alerts ───────────────────────────
plotshape(possible and not possible[1], title = "Cross became possible", style = shape.diamond,
     location = location.belowbar, color = colOk, size = size.tiny)
plotshape(not possible and possible[1] and not atTarget, title = "Cross no longer possible", style = shape.xcross,
     location = location.abovebar, color = colNo, size = size.tiny)

// Fixed-text alerts (Create alert → Condition: this indicator → pick one)
alertcondition(possible and not possible[1], "Cross possible in time", "Projected path now crosses the target before the time left runs out")
alertcondition(not possible and possible[1] and not atTarget, "Cross no longer possible in time", "Projected path no longer crosses the target in time")
alertcondition(crossedUp, "Price crossed above target", "Price crossed above the target — UP now winning")
alertcondition(crossedDown, "Price crossed below target", "Price crossed below the target — DOWN now winning")

// Live-text prompts with the time left (Create alert → Condition: this indicator → "Any alert() function call")
if possible and not possible[1]
    alert("Velocity Reach: " + statusTxt, alert.freq_once_per_bar)
if not possible and possible[1] and not atTarget
    alert("Velocity Reach: " + statusTxt, alert.freq_once_per_bar)
if crossedUp
    alert("Velocity Reach: price crossed ABOVE " + fmtP(target) + " — UP now winning, " + withinTxt + " left", alert.freq_once_per_bar)
if crossedDown
    alert("Velocity Reach: price crossed BELOW " + fmtP(target) + " — DOWN now winning, " + withinTxt + " left", alert.freq_once_per_bar)
