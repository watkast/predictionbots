# ---- Layer A (public) needs nothing. Everything below is optional. ----
# Where JSONL goes (default ./data)
MRP_DATA_DIR=./data
# 1 Hz order-book polling inside this many seconds before window end (default 180)
MRP_BOOK_HOT_SECONDS=180

# Layer B — Kalshi push feed of BRTI (+ running settlement average) and KXBTC15M books
# kalshi.com -> Account -> API keys -> create -> download the private key PEM
# KALSHI_KEY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# KALSHI_PRIVATE_KEY_PATH=/path/to/kalshi_private.pem

# Layer C — Polymarket US push order book (polymarket.us/developer)
# POLYMARKET_KEY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# POLYMARKET_SECRET_KEY=base64-ed25519-secret
