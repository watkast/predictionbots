# /etc/predictionbots/env — read by the systemd unit. chmod 600.
GITHUB_TOKEN=github_pat_xxx            # fine-grained PAT: Contents read/write on watkast/predictionbots
GITHUB_REPO=watkast/predictionbots
MRP_DATA_BRANCH=mrp-data
MRP_PUBLISH_SECONDS=600
MRP_REPORT_DAYS=3
# Recorder feeds (same values as the repo secrets; empty = that layer off)
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PEM=
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=
