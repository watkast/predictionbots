[Unit]
Description=PredictionBots recorder (read-only market data; publishes to the mrp-data branch)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=predictionbots
EnvironmentFile=/etc/predictionbots/env
WorkingDirectory=/opt/predictionbots
ExecStart=/bin/bash /opt/predictionbots/ops/dell/record_loop.sh
Restart=always
RestartSec=15
Nice=10

[Install]
WantedBy=multi-user.target
